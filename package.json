{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss && bun prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:sync-pg-schema": "bun scripts/db/sync-postgres-schema.ts",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma --accept-data-loss",
    "db:seed:postgres": "bun prisma/seed-postgres.ts",
    "db:triggers:postgres": "bun db/postgres/apply-triggers.ts",
    "db:init:postgres": "bun run db:push:postgres && bun run db:triggers:postgres && bun run db:seed:postgres",
    "db:sync-mysql-schema": "bun scripts/db/sync-mysql-schema.ts",
    "db:generate:mysql": "prisma generate --schema prisma/schema.mysql.prisma",
    "db:push:mysql": "prisma db push --schema prisma/schema.mysql.prisma --accept-data-loss",
    "db:seed:mysql": "bun prisma/seed-mysql.ts",
    "db:init:mysql": "bun run db:push:mysql && bun run db:seed:mysql",
    "db:migrate-provider": "bun scripts/db/migrate-provider.ts"
  },
  "dependencies": {
