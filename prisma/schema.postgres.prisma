  instanceId String
  cpuPct     Float    @default(0)
  memMb      Float    @default(0)
  bytesUpMb  Float    @default(0)
  bytesDownMb Float   @default(0)
  recordedAt DateTime @default(now())

  @@index([instanceId, recordedAt])
}

model HarRecord {
