}

model SingboxInstance {
  id              String   @id @default(cuid())
  name            String
  remark          String?
  tags            Json?
  cpuLimit        Float    @default(1) // 0.001 精度
  memLimitMb      Float    @default(512)
  maxSessions     Int      @default(0)
  currentSessions Int      @default(0)
  hostNodeId      String?
  containerId     String?
  status          String   @default("CREATING") // CREATING | RUNNING | STOPPED | ERROR | RELOADING | DELETED
  socksAddr       String? // 内网socks地址 host:port
  configJson      String? // 当前配置快照
  configVersion   Int      @default(0)
  autoRestart     Boolean  @default(true)
  lastError       String?
