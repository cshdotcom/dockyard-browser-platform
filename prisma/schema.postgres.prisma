// ============================================================
// 九、MCP / OpenAPI 批量任务
// ============================================================

model McpTask {
  id             String   @id @default(cuid())
  taskUuid       String   @unique @default(cuid())
  name           String
  code           String // 操作编码
  priority       String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  status         String   @default("PENDING") // PENDING | RUNNING | PAUSED | SUCCESS | FAILED | PARTIAL | ROLLED_BACK | CANCELLED
  paramsJson     String?
  resultJson     String?
  progress       Int      @default(0)
  totalItems     Int      @default(0)
  successItems   Int      @default(0)
  failedItems    Int      @default(0)
  failReasonsJson String?
  userId         String?
  createdByUserId String?
  apiTokenId     String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, priority])
  @@index([userId, createdAt])
}

model McpTaskItem {
  id             String   @id @default(cuid())
  taskId         String
  targetType     String
  targetId       String
  status         String   @default("PENDING")
  error          String?
  beforeSnapshot String?
  afterSnapshot  String?
  createdAt      DateTime @default(now())
  finishedAt     DateTime?

  @@index([taskId])
}

// ============================================================
// 十、回收站 / 风控 / 公告 / 行为画像 / 自检
// ============================================================

model RecycleBin {
  id                String    @id @default(cuid())
  resourceType      String
  resourceId        String
  resourceName      String?
  ownerUserId       String?
  createdByUserId   String?
  deletedByUserId   String?
  deletedByType     String    @default("USER") // USER | ADMIN | SYSTEM
  reason            String?
  originalSnapshot  String // 完整原始记录快照，恢复用
  locked            Boolean   @default(false) // 锁定保护
  recoverDeadline   DateTime? // 恢复时效限制
  purgeAt           DateTime? // 物理清除时间
  restoredAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([resourceType, resourceId])
  @@index([ownerUserId])
  @@index([purgeAt])
}

model RiskListRule {
  id             String   @id @default(cuid())
  type           String // IP_BLACK | IP_WHITE | UA_BLACK | DEVICE_BLACK
  value          String
  note           String?
  mode           String   @default("PERMANENT") // TEMP | PERMANENT
  expiresAt      DateTime?
  // —— 作用域：登录/入口级风控仍取 GLOBAL；用户/组/单沙箱级 IP 黑白名单供策略下发中心批量落规则 ——
  scopeType      String   @default("GLOBAL") // GLOBAL | GROUP | USER | SANDBOX
  groupId        String?
  userId         String?
  workspaceId    String? // scopeType=SANDBOX 时生效（单沙箱定向 IP 限制）
  deploymentId   String?  // 来源策略下发批次（回滚时整批清理）
  createdByUserId String?
  createdAt      DateTime @default(now())

  @@index([type, value])
  @@index([scopeType, groupId])
  @@index([scopeType, userId])
  @@index([scopeType, workspaceId])
}

// ============================================================
// 策略下发中心：管理员按【用户/用户组】批量下发访问控制策略包
// 策略包字段：内网开关 / 容器安全位置开关 / 域名黑白名单 / IP 黑白名单
// 每次下发全量快照前置状态，支持一键回滚；逐目标结果落库可审计
// ============================================================
model PolicyDeployment {
  id              String   @id @default(cuid())
  name            String // 下发批次名称
  bundleJson      String   // 下发的策略包内容（规范化后）
  targetUsers     Json? // 目标用户ID列表
  targetGroups    Json? // 目标用户组ID列表
  targetWorkspaces Json? // 目标沙箱ID列表（单沙箱定向限制下发）
  status          String   @default("PENDING") // PENDING(定时待生效) | RUNNING | SUCCESS | PARTIAL | FAILED | ROLLED_BACK | CANCELLED
  // —— 定时生效：IMMEDIATE 立即执行；SCHEDULED 到 effectiveAt 由定时任务自动激活 ——
  effectiveMode   String   @default("IMMEDIATE") // IMMEDIATE | SCHEDULED
  effectiveAt     DateTime? // 定时生效时刻（仅 SCHEDULED）
  activatedAt     DateTime? // 实际激活执行时刻
  cancelledAt     DateTime? // 定时批次被取消时刻
  cancelledByUserId String?
  totalTargets    Int      @default(0)
  successTargets  Int      @default(0)
  failedTargets   Int      @default(0)
  resultsJson     String? // 逐目标执行结果 [{targetId,targetType,targetName,ok,reason}]
  snapshotJson    String? // 下发前全量状态快照（回滚依据）
  note            String?
  createdByUserId String?
  deployedAt      DateTime?
  finishedAt      DateTime?
  rolledBackAt    DateTime?
  rolledBackByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status, effectiveAt])
  @@index([createdByUserId])
}

// ============================================================
// 文件访问限制策略（File Access Policy）—— 四层配置条目
// 作用域：GLOBAL / GROUP / USER / SANDBOX（单沙箱），unique[scopeType, scopeId]
// 可控维度（执行层：Chromium 托管策略 + 只读策略文件注入）：
//   · allowDownload   —— 是否允许浏览器下载文件（false → DownloadRestrictions=2 全禁）
//   · allowUpload     —— 是否允许选择本机文件上传（false → AllowFileSelectionDialogs=false 拾取器封禁）
//   · allowFileScheme —— 是否允许 file:// 本地文件访问（false → URLBlocklist file://*）
// 解析：SANDBOX > USER > GROUP（沿继承链）> GLOBAL > 系统默认（下载/上传允许、file:// 禁止）
// ============================================================
model FilePolicyConfig {
  id              String   @id @default(cuid())
  scopeType       String // GLOBAL | GROUP | USER | SANDBOX
  scopeId         String // 对应 groupId/userId/workspaceId（GLOBAL 层恒为空串）
  allowDownload   Boolean  @default(true)
  allowUpload     Boolean  @default(true)
  allowFileScheme Boolean  @default(false)
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([scopeId])
}

// 端点级精确限制规则（host:port / host:* / CIDR:port / 方案级）
// 与域名规则同一作用域模型（GLOBAL/GROUP/USER/SANDBOX 四层合并），供策略下发中心批量落规则
model NetworkEndpointRule {
  id             String   @id @default(cuid())
  pattern        String // 形如 10.0.0.5:8080 / 192.168.1.*:443 / *.corp.com:22 / 127.0.0.1:* / [::1]:9222
  type           String   @default("BLACK") // BLACK | WHITE（WHITE=显式放行例外）
  enabled        Boolean  @default(true)
  note           String?
  scopeType      String   @default("GLOBAL") // GLOBAL | GROUP | USER | SANDBOX
  groupId        String? // scopeType=GROUP 时生效
  userId         String? // scopeType=USER 时生效
  workspaceId    String? // scopeType=SANDBOX 时生效（单沙箱定向限制）
  deploymentId   String?  // 来源策略下发批次（回滚时整批清理）
  priority       Int      @default(0)
  createdByUserId String?
  createdAt      DateTime @default(now())

  @@index([scopeType, groupId])
  @@index([scopeType, userId])
  @@index([scopeType, workspaceId])
  @@index([type, enabled])
}

model PolicyTemplate {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  bundleJson      String   // 模板策略包（同 PolicyDeployment.bundleJson 结构）
  builtin         Boolean  @default(false) // 内置模板不可删除
  usageCount      Int      @default(0)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([builtin])
  @@index([deletedAt])
}

model UserBehaviorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  resourcesCreated Int      @default(0)
  resourcesDeleted Int      @default(0)
  resourcesRestored Int     @default(0)
  mcpCalls         Int      @default(0)
  vncDurationMin   Float    @default(0)
  batchOps         Int      @default(0)
  abnormalOps      Int      @default(0)
  riskTriggers     Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  content        String
  type           String   @default("GLOBAL") // GLOBAL | GROUP | USER
  groupId        String?
  userId         String?
  displayType    String   @default("POPUP") // POPUP | MARQUEE | FORCE_VIEW（主展示方式 = displayTypes 首项，兼容旧数据）
  displayTypes   String?  // 多选展示方式（JSON 数组，如 ["POPUP","MARQUEE"]；空数组=仅站内信）
  notifyInbox    Boolean  @default(false) // 站内信通道（发送到用户通知铃/站内信）
  notifiedAt     DateTime? // 站内信已投递时间（幂等防重发：投递一次后永不重发）
  startAt        DateTime? // 显示开始时间（null=立即显示；未到开始时间不展示）
  endAt          DateTime? // 结束时间（null=永久；过期后不再展示，站内信保留可回看）
  persistAfterRead Boolean @default(false) // 已读后持续显示（弹窗每次刷新仍弹出，除非勾选今日不再提醒）
  allowDismiss   Boolean  @default(true) // 允许用户勾选「今日不再提醒」（管理员可控；跑马灯的今日不显示同样受控）
  enabled        Boolean  @default(true)
  createdByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, enabled])
  @@index([enabled, endAt])
}

model AnnouncementDismiss {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  dismissDate    String   // 今日不再提醒：yyyy-MM-DD（本地时区日）
  dismissedAt    DateTime @default(now())

  @@unique([announcementId, userId, dismissDate])
  @@index([userId, dismissDate])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  @@unique([announcementId, userId])
}

model ResourceLifecycleRule {
  id             String   @id @default(cuid())
  resourceType   String
  resourceId     String?
  scopeType      String   @default("RESOURCE") // RESOURCE | GROUP | GLOBAL
  scopeId        String?
  rulesJson      String // { autoPauseAt, autoFreezeAt, autoExpireAt, autoRecycleAt, autoDeleteAt }
  enabled        Boolean  @default(true)
  createdByUserId String?
  createdAt      DateTime @default(now())
}

model SystemSelfCheck {
  id          String   @id @default(cuid())
  checkCode   String
  status      String   @default("PASS") // PASS | WARN | FAIL | FIXED
  detail      String?
  fixedAction String?
  createdAt   DateTime @default(now())

  @@index([checkCode, createdAt])
}

// ============================================================
// CRX 扩展管控体系（企业浏览器后台 · 零内核 Patch · Managed Preferences 原生策略）
// 约束：后台不存 CRX 二进制，只维护扩展 ID + update_url 元数据；
//      全部依赖 Chromium ExtensionInstallForcelist / Blocklist / ExtensionSettings 原生策略
// ============================================================

// CRX 插件资源库（元数据库；所有下发沙箱的插件必须先录入）
model CrxPlugin {
  id                 String    @id @default(cuid())
  crxId              String    @unique // Chrome/Edge 商店真实 32 位扩展 ID
  name               String
  description        String?
  zhNote             String? // 中文备注
  tags               Json? // 业务标签 ["office","dev","ops","highrisk"]
  permissions        Json? // manifest 权限清单（自动导入 / 手动录入）
  updateUrl          String // 主安装源 update_url
  backupUpdateUrl    String? // 备用安装源（降级）
  lockedVersion      String? // 强制锁定版本（禁止自动升级）
  allowIncognito     Boolean   @default(false) // 允许无痕运行（全局默认，下发可覆盖）
  allowUserDisable   Boolean   @default(true) // false=用户沙箱内不能禁用（force_installed）
  highRisk           Boolean   @default(false) // 高危标记（按 manifest 权限自动判定）
  highRiskReason     Json? // ["all_urls","clipboardRead",...]
  enabled            Boolean   @default(true) // 库内禁用：禁用后所有继承沙箱不再安装
  docUrl             String? // 内部文档链接
  createdByUserId    String?
  createdByName      String?
  updatedByUserId    String?
  updatedByName      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? // 软删（插件库回收站）
  deletedByUserId    String?
  deletedByName      String?

  @@index([deletedAt])
  @@index([enabled])
  @@index([highRisk])
  @@index([createdAt])
}

// 五级 CRX 策略条目（强制安装列表项：GLOBAL / GROUP / USER / SANDBOX 层）
model CrxPolicyEntry {
  id               String    @id @default(cuid())
  scopeType        String // GLOBAL | GROUP | USER | SANDBOX
  scopeId          String? // 对应 groupId/userId/workspaceId（GLOBAL 为空）
  crxId            String
  updateUrl        String? // 覆盖主源
  backupUpdateUrl  String? // 覆盖备用源
  lockedVersion    String? // 覆盖锁定版本
  allowIncognito   Boolean? // 覆盖无痕运行
  allowUserDisable Boolean? // 覆盖可禁用
  note             String?
  createdByUserId  String?
  createdByName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@unique([scopeType, scopeId, crxId])
  @@index([scopeType, scopeId])
  @@index([crxId])
}

// CRX 黑名单（强制禁止安装；GLOBAL 层为主，黑名单不随继承开关失效）
model CrxBlocklistEntry {
  id              String   @id @default(cuid())
  scopeType       String // GLOBAL | GROUP | USER | SANDBOX
  scopeId         String?
  crxId           String
  note            String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())

  @@unique([scopeType, scopeId, crxId])
  @@index([crxId])
}

// 沙箱逐插件安装状态（安装调度状态机）
model CrxInstallStatus {
  id              String    @id @default(cuid())
  workspaceId     String
  crxId           String
  state           String    @default("PENDING") // PENDING | POLICY_APPLIED | INSTALLED | PRIMARY_FAILED | BACKUP_RETRY | ALL_FAILED | VERSION_MISMATCH
  sourceUsed      String? // 当前使用的源（主/备）
  currentVersion  String? // 实际安装版本（CDP 检测）
  attempts        Int       @default(0)
  lastErrorCode   String?
  lastErrorAt     DateTime?
  lastCheckedAt   DateTime?
  resolvedBy      String? // SANDBOX | USER | GROUP | GLOBAL | LIBRARY
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, crxId])
  @@index([workspaceId])
  @@index([state])
  @@index([crxId])
}

// CRX 灰度下发任务（分批推送 + 一键回滚；回滚仅超级管理员）
model CrxGrayTask {
  id              String    @id @default(cuid())
  name            String
  entriesJson     String // [{ crxId, updateUrl?, lockedVersion?, allowIncognito?, allowUserDisable? }]
  targetIds       Json // [workspaceId,...] 灰度目标沙箱
  status          String    @default("PENDING") // PENDING | ROLLING | SUCCESS | PARTIAL | ROLLED_BACK | CANCELLED
  batchSize       Int       @default(3)
  total           Int       @default(0)
  progressed      Int       @default(0)
  successCount    Int       @default(0)
  failCount       Int       @default(0)
  rollbackReason  String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime  @default(now())
  activatedAt     DateTime?
  finishedAt      DateTime?

  @@index([status])
  @@index([createdAt])
}
