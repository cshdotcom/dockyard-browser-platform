// 沙箱共享临时链接（带有效期 + 权限控制）：
// 已登录用户访问 /workspaces/shared?token=xxx → 校验通过后自动绑定为目标共享（WorkspaceShare），
// 之后与普通共享完全一致（VNC 观看/操作、HAR 下载等按 permission 生效）
model WorkspaceShareLink {
  id             String    @id @default(cuid()) @db.VarChar(64)
  workspaceId    String @db.VarChar(64)
  token          String    @unique @db.VarChar(255) // 32 字节随机 hex（不可猜测）
  permission     String    @default("VIEW") @db.VarChar(255) // VIEW | OPERATE
  expireAt       DateTime? // null=永久有效
  revokedAt      DateTime? // 撤销后立即失效
  maxUses        Int       @default(0) // 最大使用次数（0=不限；每次访问绑定记 1 次）
  useCount       Int       @default(0)
  lastUsedAt     DateTime?
  note           String? @db.Text // 备注说明（分享给谁/什么用途）
  createdByUserId String? @db.VarChar(64)
  createdAt      DateTime  @default(now())
  // r37：访客访问（免登录）+ 密码保护 + 允许/禁止名单（完整权限管理）
  passwordHash   String? @db.VarChar(255) // argon2/bcrypt 哈希（null=无密码；访客与兑换均需校验）
  guestAllowed   Boolean   @default(false) // 允许访客（未登录）访问：VNC 只读观看或可操作
  guestCdp       Boolean   @default(false) // 访客可用 CDP（要求 permission=OPERATE；读写级）
  allowUserIds   Json?     // 允许兑换的用户 id 白名单（null/[] = 不限）
  denyUserIds    Json?     // 禁止兑换的用户 id 黑名单（优先于白名单）
  allowGroupIds  Json?     // 允许兑换的用户组白名单（null/[] = 不限）
  denyGroupIds   Json?     // 禁止兑换的用户组黑名单（deny 优先）
  guestUseCount  Int       @default(0) // 访客访问次数（独立统计）
  lastGuestAt    DateTime? // 最近访客访问时间
  lastGuestIp    String? @db.Text // 最近访客来源 IP（安全审计）

  @@index([workspaceId])
}

// r37：CDP 公网连接地址（持久票据）全生命周期管理
// 场景：用户持有 ws://host:port/p/<tid> 形式的公网连接地址；地址泄露后可一键
// 「重新创建」（轮换：旧地址立即失效 + 生成新地址）；有效期支持 永久/自定义；
// 管理员可强制吊销/轮换（用户/用户组/沙箱级 + 批量）；网关经主应用内部 API
// 实时校验（吊销/过期/次数即时生效）。
model CdpEndpointToken {
  id             String    @id @default(cuid()) @db.VarChar(64)
  tid            String    @unique @db.VarChar(64) // 48 位随机 hex（公网地址组成部分，不可猜测）
  workspaceId    String @db.VarChar(64)
  userId         String? @db.VarChar(64) // 归属用户（工作区所有者）
  label          String? @db.VarChar(255) // 标签（如「自动化接入」）
  note           String? @db.Text // 备注
  expireAt       DateTime? // null=永久有效
  maxUses        Int       @default(0) // 0=不限次数；每次建连 +1
  useCount       Int       @default(0)
  lastUsedAt     DateTime?
  lastUsedIp     String? @db.Text
  revokedAt      DateTime? // 吊销（轮换时旧票据置此标记）
  revokeReason   String? @db.Text
  rotatedFromId  String? @db.VarChar(64) // 轮换来源（新票据指向旧票据，血缘可追溯）
  createdVia     String    @default("USER") @db.VarChar(255) // USER | ADMIN（管理员强制创建）
  createdByUserId String? @db.VarChar(64)
  createdAt      DateTime  @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([revokedAt])
}

model BrowserNode {
  id            String   @id @default(cuid()) @db.VarChar(64)
  name          String @db.VarChar(255)
  baseUrl       String @db.VarChar(700)
  // r32：公网展示地址（外部工具/跨域接入展示用；空 = 连接信息回退 ENV 推导）
  publicUrl     String? @db.VarChar(700)
  // r33：公网 CDP 接入地址（每浏览器节点独立填写，如 wss://cdp.example.com 或 host:port；
