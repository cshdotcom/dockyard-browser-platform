  crxId           String @db.VarChar(64)
  note            String? @db.Text
  createdByUserId String? @db.VarChar(64)
  createdByName   String? @db.Text
  createdAt       DateTime @default(now())

  @@unique([scopeType, scopeId, crxId])
  @@index([crxId])
}

// 沙箱逐插件安装状态（安装调度状态机）
model CrxInstallStatus {
  id              String    @id @default(cuid()) @db.VarChar(64)
  workspaceId     String @db.VarChar(64)
  crxId           String @db.VarChar(64)
  state           String    @default("PENDING") @db.VarChar(255) // PENDING | POLICY_APPLIED | INSTALLED | PRIMARY_FAILED | BACKUP_RETRY | ALL_FAILED | VERSION_MISMATCH
  sourceUsed      String? @db.Text // 当前使用的源（主/备）
  currentVersion  String? @db.Text // 实际安装版本（CDP 检测）
  attempts        Int       @default(0)
  lastErrorCode   String? @db.Text
  lastErrorAt     DateTime?
  lastCheckedAt   DateTime?
  resolvedBy      String? @db.Text // SANDBOX | USER | GROUP | GLOBAL | LIBRARY
  createdAt       DateTime  @default(now())
