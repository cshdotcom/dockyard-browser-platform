// ============================================================
// CRX 扩展管控体系（企业浏览器后台 · 零内核 Patch · Managed Preferences 原生策略）
// 约束：后台不存 CRX 二进制，只维护扩展 ID + update_url 元数据；
//      全部依赖 Chromium ExtensionInstallForcelist / Blocklist / ExtensionSettings 原生策略
// ============================================================

// CRX 插件资源库（元数据库；所有下发沙箱的插件必须先录入）
model CrxPlugin {
  id                 String    @id @default(cuid()) @db.VarChar(64)
  crxId              String    @unique @db.VarChar(64) // Chrome/Edge 商店真实 32 位扩展 ID
  name               String @db.VarChar(255)
  description        String? @db.Text
  zhNote             String? @db.Text // 中文备注
  tags               Json? // 业务标签 ["office","dev","ops","highrisk"]
  permissions        Json? // manifest 权限清单（自动导入 / 手动录入）
  updateUrl          String @db.VarChar(700) // 主安装源 update_url
  backupUpdateUrl    String? @db.VarChar(700) // 备用安装源（降级）
  lockedVersion      String? @db.Text // 强制锁定版本（禁止自动升级）
  allowIncognito     Boolean   @default(false) // 允许无痕运行（全局默认，下发可覆盖）
  allowUserDisable   Boolean   @default(true) // false=用户沙箱内不能禁用（force_installed）
  highRisk           Boolean   @default(false) // 高危标记（按 manifest 权限自动判定）
  highRiskReason     Json? // ["all_urls","clipboardRead",...]
  enabled            Boolean   @default(true) // 库内禁用：禁用后所有继承沙箱不再安装
  docUrl             String? @db.VarChar(700) // 内部文档链接
  createdByUserId    String? @db.VarChar(64)
  createdByName      String? @db.Text
  updatedByUserId    String? @db.VarChar(64)
  updatedByName      String? @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? // 软删（插件库回收站）
  deletedByUserId    String? @db.VarChar(64)
  deletedByName      String? @db.Text

  @@index([deletedAt])
  @@index([enabled])
  @@index([highRisk])
  @@index([createdAt])
}

// 五级 CRX 策略条目（强制安装列表项：GLOBAL / GROUP / USER / SANDBOX 层）
model CrxPolicyEntry {
  id               String    @id @default(cuid()) @db.VarChar(64)
  scopeType        String @db.VarChar(300) // GLOBAL | GROUP | USER | SANDBOX
  scopeId          String? @db.VarChar(64) // 对应 groupId/userId/workspaceId（GLOBAL 为空）
  crxId            String @db.VarChar(64)
  updateUrl        String? @db.VarChar(700) // 覆盖主源
  backupUpdateUrl  String? @db.VarChar(700) // 覆盖备用源
  lockedVersion    String? @db.Text // 覆盖锁定版本
  allowIncognito   Boolean? // 覆盖无痕运行
  allowUserDisable Boolean? // 覆盖可禁用
  note             String? @db.Text
  createdByUserId  String? @db.VarChar(64)
  createdByName    String? @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@unique([scopeType, scopeId, crxId])
  @@index([scopeType, scopeId])
  @@index([crxId])
}

// CRX 黑名单（强制禁止安装；GLOBAL 层为主，黑名单不随继承开关失效）
model CrxBlocklistEntry {
  id              String   @id @default(cuid()) @db.VarChar(64)
  scopeType       String @db.VarChar(300) // GLOBAL | GROUP | USER | SANDBOX
