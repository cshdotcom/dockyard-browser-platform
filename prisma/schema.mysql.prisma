// ============================================================
// r29：Master/Worker 双包架构 —— Worker 工作节点
//   Master（本服务）：元数据/调度/权限/策略/审计中枢；Worker：纯执行节点
//   注册：管理员创建 → WORKER_NODE_UUID + WORKER_API_KEY（仅创建时一次性展示）
//   通信：心跳（10s）上报资源；密钥泄露 → 驱逐（Worker 永久失效）
// ============================================================

model WorkNode {
  id               String    @id @default(cuid()) @db.VarChar(64)
  nodeUuid         String    @unique @db.VarChar(64) // WORKER_NODE_UUID
  name             String @db.VarChar(255)
  region           String    @default("default") @db.VarChar(255) // 归属区域（调度锁定用）
  note             String? @db.Text
  apiKeyHash       String @db.VarChar(255) // WORKER_API_KEY SHA-256（明文永不回显）
  enabled          Boolean   @default(true)
  status           String    @default("PENDING") @db.VarChar(255) // PENDING(已注册未接入) | ONLINE | OFFLINE | EVICTED
  // 心跳上报（最近一次快照）
  cpuUsage         Float?
  memUsage         Float?
  diskUsage        Float?
  diskFreeMb       Int?
  sandboxCount     Int       @default(0)
  sandboxRunning   Int       @default(0)
  netInKbps        Float?
  netOutKbps       Float?
  version          String? @db.VarChar(255)
  hostname         String? @db.Text
  lastHeartbeatAt  DateTime?
  // 调度容量
  maxSandboxes     Int       @default(20)
  storageUsedMb    Int       @default(0)
  // r29-d：资源告警阈值节点级覆盖（null=继承全局 worknode.* 配置）
  cpuThresholdPct  Int?
  memThresholdPct  Int?
  diskThresholdPct Int?
  evictedAt        DateTime?
  evictReason      String? @db.Text
  createdByUserId  String? @db.VarChar(64)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([region, status])
  @@index([status])
  @@index([lastHeartbeatAt])
}

model RiskListRule {
  id             String   @id @default(cuid()) @db.VarChar(64)
  type           String @db.VarChar(255) // IP_BLACK | IP_WHITE | UA_BLACK | DEVICE_BLACK
  value          String @db.VarChar(300)
  note           String? @db.Text
  mode           String   @default("PERMANENT") @db.VarChar(255) // TEMP | PERMANENT
  expiresAt      DateTime?
  // —— 作用域：登录/入口级风控仍取 GLOBAL；用户/组/单沙箱级 IP 黑白名单供策略下发中心批量落规则 ——
  scopeType      String   @default("GLOBAL") @db.VarChar(255) // GLOBAL | GROUP | USER | SANDBOX
  groupId        String? @db.VarChar(64)
  userId         String? @db.VarChar(64)
  workspaceId    String? @db.VarChar(64) // scopeType=SANDBOX 时生效（单沙箱定向 IP 限制）
  deploymentId   String? @db.VarChar(64) // 来源策略下发批次（回滚时整批清理）
  createdByUserId String? @db.VarChar(64)
  createdAt      DateTime @default(now())

  @@index([type, value])
  @@index([scopeType, groupId])
  @@index([scopeType, userId])
  @@index([scopeType, workspaceId])
}

// ============================================================
// 策略下发中心：管理员按【用户/用户组】批量下发访问控制策略包
// 策略包字段：内网开关 / 容器安全位置开关 / 域名黑白名单 / IP 黑白名单
// 每次下发全量快照前置状态，支持一键回滚；逐目标结果落库可审计
// ============================================================
model PolicyDeployment {
  id              String   @id @default(cuid()) @db.VarChar(64)
  name            String @db.VarChar(255) // 下发批次名称
  bundleJson      String @db.MediumText // 下发的策略包内容（规范化后）
  targetUsers     Json? // 目标用户ID列表
  targetGroups    Json? // 目标用户组ID列表
  targetWorkspaces Json? // 目标沙箱ID列表（单沙箱定向限制下发）
  status          String   @default("PENDING") @db.VarChar(255) // PENDING(定时待生效) | RUNNING | SUCCESS | PARTIAL | FAILED | ROLLED_BACK | CANCELLED
  // —— 定时生效：IMMEDIATE 立即执行；SCHEDULED 到 effectiveAt 由定时任务自动激活 ——
  effectiveMode   String   @default("IMMEDIATE") @db.VarChar(255) // IMMEDIATE | SCHEDULED
  effectiveAt     DateTime? // 定时生效时刻（仅 SCHEDULED）
  activatedAt     DateTime? // 实际激活执行时刻
  cancelledAt     DateTime? // 定时批次被取消时刻
  cancelledByUserId String? @db.VarChar(64)
  totalTargets    Int      @default(0)
  successTargets  Int      @default(0)
  failedTargets   Int      @default(0)
  resultsJson     String? @db.MediumText // 逐目标执行结果 [{targetId,targetType,targetName,ok,reason}]
  snapshotJson    String? @db.MediumText // 下发前全量状态快照（回滚依据）
  note            String? @db.Text
  createdByUserId String? @db.VarChar(64)
  deployedAt      DateTime?
  finishedAt      DateTime?
  rolledBackAt    DateTime?
  rolledBackByUserId String? @db.VarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status, effectiveAt])
  @@index([createdByUserId])
}

// ============================================================
// 文件访问限制策略（File Access Policy）—— 四层配置条目
// 作用域：GLOBAL / GROUP / USER / SANDBOX（单沙箱），unique[scopeType, scopeId]
// 可控维度（执行层：Chromium 托管策略 + 只读策略文件注入）：
//   · allowDownload   —— 是否允许浏览器下载文件（false → DownloadRestrictions=2 全禁）
//   · allowUpload     —— 是否允许选择本机文件上传（false → AllowFileSelectionDialogs=false 拾取器封禁）
//   · allowFileScheme —— 是否允许 file:// 本地文件访问（false → URLBlocklist file://*）
// 解析：SANDBOX > USER > GROUP（沿继承链）> GLOBAL > 系统默认（下载/上传允许、file:// 禁止）
// ============================================================
model FilePolicyConfig {
  id              String   @id @default(cuid()) @db.VarChar(64)
  scopeType       String @db.VarChar(300) // GLOBAL | GROUP | USER | SANDBOX
  scopeId         String @db.VarChar(64) // 对应 groupId/userId/workspaceId（GLOBAL 层恒为空串）
  allowDownload   Boolean  @default(true)
  allowUpload     Boolean  @default(true)
  allowFileScheme Boolean  @default(false)
  note            String? @db.Text
  createdByUserId String? @db.VarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([scopeId])
}

// 端点级精确限制规则（host:port / host:* / CIDR:port / 方案级）
// 与域名规则同一作用域模型（GLOBAL/GROUP/USER/SANDBOX 四层合并），供策略下发中心批量落规则
model NetworkEndpointRule {
  id             String   @id @default(cuid()) @db.VarChar(64)
  pattern        String @db.Text // 形如 10.0.0.5:8080 / 192.168.1.*:443 / *.corp.com:22 / 127.0.0.1:* / [::1]:9222
  type           String   @default("BLACK") @db.VarChar(255) // BLACK | WHITE（WHITE=显式放行例外）
  enabled        Boolean  @default(true)
  note           String? @db.Text
  scopeType      String   @default("GLOBAL") @db.VarChar(255) // GLOBAL | GROUP | USER | SANDBOX
  groupId        String? @db.VarChar(64) // scopeType=GROUP 时生效
  userId         String? @db.VarChar(64) // scopeType=USER 时生效
  workspaceId    String? @db.VarChar(64) // scopeType=SANDBOX 时生效（单沙箱定向限制）
  deploymentId   String? @db.VarChar(64) // 来源策略下发批次（回滚时整批清理）
  priority       Int      @default(0)
  createdByUserId String? @db.VarChar(64)
  createdAt      DateTime @default(now())

  @@index([scopeType, groupId])
  @@index([scopeType, userId])
  @@index([scopeType, workspaceId])
  @@index([type, enabled])
}

model PolicyTemplate {
  id              String   @id @default(cuid()) @db.VarChar(64)
  name            String   @unique @db.VarChar(255)
  description     String? @db.Text
  bundleJson      String @db.MediumText // 模板策略包（同 PolicyDeployment.bundleJson 结构）
  builtin         Boolean  @default(false) // 内置模板不可删除
  usageCount      Int      @default(0)
  createdByUserId String? @db.VarChar(64)
  createdAt       DateTime @default(now())
