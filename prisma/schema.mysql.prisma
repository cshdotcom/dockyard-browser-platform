  ownerUserId    String @db.VarChar(64)
  accessMode     String    @default("LOGIN") @db.VarChar(255) // PUBLIC(免登录) | LOGIN(需登录) | USERS(指定用户/组)
  allowedUsers   Json?     // { userIds: [], groupIds: [] } 名单（USERS 模式）
  expiresAt      DateTime? // null = 永久有效
  maxViews       Int?      // null = 不限查看次数
  maxDownloads   Int?      // null = 不限下载次数
  downloadKBps   Int?      // null = 继承用户/全局限速
  viewCount      Int       @default(0)
  downloadCount  Int       @default(0)
  note           String? @db.Text
