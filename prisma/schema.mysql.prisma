  policyAllowInternalNetwork     Boolean? // 沙箱级：允许访问内网（非 null 即覆盖上层）
  policyAllowSecureLocationAccess Boolean? // 沙箱级：允许访问容器内安全位置（非 null 即覆盖上层）
  crxInheritEnabled Boolean   @default(true) // CRX 扩展上层继承开关（false=完全使用本沙箱插件列表，黑名单仍继承）
  crxBlocklistExempt Boolean  @default(false) // 超管单独豁免黑名单插件（仅沙箱级）
  sessionSecAccum   Int       @default(0) // VNC 会话累计连接秒数（策略执行统计）
  cdpCallCount       Int       @default(0)
  cdpBlockedCount    Int       @default(0)
  crashCategory      String? @db.Text
  lifecycleRules     Json?    // 定时生命周期策略
  freezeReason       String? @db.Text
  expireAt           DateTime?
  // —— r24-c：每沙箱输入法/键盘布局偏好（独立 X 显示内生效，跨沙箱互不影响）——
  imeEngine          String? @db.Text // 偏好输入法引擎（如 pinyin；空=跟随容器默认）
  kbLayout           String? @db.Text // 偏好键盘布局（如 us/cn/de/fr…；空=跟随默认）
  // —— r27：VNC 会话录像沙箱级覆盖（"on"/"off"；null=继承 用户>组>全局 默认）——
  recordingOverride  String? @db.Text
  // —— r35：网页模式（kiosk 纯网页内容：Chromium --kiosk 启动指定 URL，无浏览器控制栏）——
  kioskMode          Boolean   @default(false)
  kioskStartUrl      String? @db.VarChar(700)
  // —— r28：回放安全沙箱级覆盖 { watermark: force|on|off, allowExport }（null=继承上层）——
  vncPlayback Json?
  // —— r29：17 项硬件权限沙箱级覆盖（稀疏 JSON；null=继承用户/组/全局）——
  hardwareOverride Json?
  containerRef       String? @db.Text // 自托管硬隔离浏览器容器（name/id，防退出看门狗自愈目标）
  hardeningJson      Json?    // 隔离防护快照（只读根FS/CapDrop/noexec下载/独立Profile卷/防退出循环）
  networkPolicyJson  Json?    // 生效网络策略快照 { allowInternalNetwork, allowSecureLocationAccess, source, enforcedAt, domainMode, domainBlack, domainWhite, endpointBlack, endpointWhite }
  startedAt          DateTime? // 最近一次启动时间（运行时长计算基准；停止时冻结增量入 runtimeAccumSec）
  runtimeAccumSec    Int       @default(0) // 累计运行秒数（不含当前运行段）
  lastActiveAt       DateTime? // 最近活跃（VNC取票/CDP指令/脚本执行触发）
  createdByUserId    String? @db.VarChar(64)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([userId, deletedAt])
  @@index([status])
  @@index([groupId])
  @@index([createdAt])
}

