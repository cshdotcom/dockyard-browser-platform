// CRX 灰度下发任务（分批推送 + 一键回滚；回滚仅超级管理员）
// ============================================================
// r27：VNC 会话录像（企业级录屏审计）
// 生命周期：沙箱启动（策略四级链命中）→ 沙箱进程树内 ffmpeg x11grab 分段
// 落盘到用户空间 storage/recordings/<userId>/<sandboxId>/seg-NNN.mp4 →
// 平台扫描任务发现分段并入库（RECORDING→COMPLETED）→ 后台/用户空间回放
// （HTTP Range 流）→ 软删入回收站 → 恢复/物理清除；保留期与配额由
// 定时任务自动执行。分组语义：sessionId = 沙箱进程树 id（一次"启动→停止"
// = 一组录像会话，组内按 segmentIndex 分段，浏览器进程自愈重启不中断）。
// ============================================================
model VncRecording {
  id             String    @id @default(cuid()) @db.VarChar(64)
  workspaceId    String @db.VarChar(64)
  workspaceUuid  String? @db.VarChar(64) // 冗余（工作区删除后仍可溯源）
  workspaceName  String @db.Text // 冗余同上（列表可读）
  userId         String @db.VarChar(64) // 归属用户（录像文件存其用户空间）
  username       String? @db.VarChar(255) // 冗余（用户删除后可读）
  sessionId      String @db.VarChar(64) // 录像会话组（= 沙箱进程树 id emb-*/dy-browser-*）
  segmentIndex   Int       @default(0) // 组内分段序号（0 起）
  status         String    @default("RECORDING") @db.VarChar(255) // RECORDING | COMPLETED | FAILED
  trigger        String    @default("AUTO") @db.VarChar(255) // AUTO（策略自动开录）| MANUAL（管理员手动取证）
  startedAt      DateTime  @default(now()) // 本段开始
  endedAt        DateTime? // 本段结束（扫描/终结时回填）
  durationSec    Int       @default(0)
  sizeBytes      Int       @default(0)
  storageKey     String? @db.VarChar(400) // 相对 storage 根路径（recordings/<userId>/<sessionId>/seg-NNN.mp4）
  resolution     String? @db.Text
  fps            Int       @default(12)
  policySource   String? @db.Text // 录像策略命中层（SANDBOX|USER|GROUP|GLOBAL_DEFAULT）
  note           String? @db.Text
  viewCount      Int       @default(0)
  lastViewedAt   DateTime?
  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  metadata       Json?     // 溯源（模板/策略快照/浏览器版本等）
  deletedAt      DateTime? // 软删 → 回收站
  purgeAt        DateTime? // 物理清除计划时间（保留期到期）
  restoredAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sessionId, segmentIndex]) // 幂等：补行/注册双通道不会产生重复分段行
  @@index([userId, deletedAt])
  @@index([workspaceId])
  @@index([status, deletedAt])
  @@index([deletedAt, purgeAt])
  @@index([createdAt])
}

model CrxGrayTask {
  id              String    @id @default(cuid()) @db.VarChar(64)
  name            String @db.VarChar(255)
  entriesJson     String @db.MediumText // [{ crxId, updateUrl?, lockedVersion?, allowIncognito?, allowUserDisable? }]
  targetIds       Json // [workspaceId,...] 灰度目标沙箱
  status          String    @default("PENDING") @db.VarChar(255) // PENDING | ROLLING | SUCCESS | PARTIAL | ROLLED_BACK | CANCELLED
  batchSize       Int       @default(3)
  total           Int       @default(0)
  progressed      Int       @default(0)
  successCount    Int       @default(0)
  failCount       Int       @default(0)
  rollbackReason  String? @db.Text
  createdByUserId String? @db.VarChar(64)
  createdByName   String? @db.Text
  createdAt       DateTime  @default(now())
  activatedAt     DateTime?
  finishedAt      DateTime?

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// r29-b：硬件远程监视授权（双模式）
//   CONSENT 知情模式 —— 用户 VNC 顶部横幅（红点+一键切断）
//   SILENT  静默特权模式 —— 仅超管可授予；对用户完全无感知；强制审计
// ============================================================

model MonitorGrant {
  id              String    @id @default(cuid()) @db.VarChar(64)
  workspaceId     String @db.VarChar(64)
  userId          String? @db.VarChar(64) // 被监控用户（冗余，展示与筛选）
  channel         String @db.VarChar(255) // camera | microphone | screenShare
  mode            String @db.VarChar(255) // CONSENT | SILENT
  reason          String? @db.Text // 授权理由（SILENT 必填）
  grantedByUserId String @db.VarChar(64)
  grantedByName   String @db.Text
  active          Boolean   @default(true)
  cutOffBy        String? @db.Text // USER_CUTOFF | ADMIN_REVOKE | SESSION_END
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, active])
  @@index([active, mode])
  @@index([userId, active])
}

// ============================================================
// r29-e：虚拟媒体投递（云盘音视频定点秒级投递 + 图片恒定帧虚拟摄像头）
// ============================================================

model MediaCast {
  id                 String    @id @default(cuid()) @db.VarChar(64)
  workspaceId        String @db.VarChar(64)
  userId             String? @db.VarChar(64)
  fileName           String @db.Text
  mediaKind          String @db.Text // video | audio
  seekSec            Int       @default(0) // 定点秒
  storagePath        String? @db.Text // 沙箱内投递文件路径（重置即清理）
  castPid            Int? // ffplay 进程（存活巡检自动收口）
  status             String    @default("PLAYING") @db.VarChar(255) // PLAYING | STOPPED
  stopReason         String? @db.Text // RESET | REPLACE | EXITED
  deliveredByUserId  String? @db.VarChar(64)
  deliveredByName    String? @db.Text
  startedAt          DateTime  @default(now())
  stoppedAt          DateTime?

  @@index([workspaceId, status])
  @@index([status])
}

// ============================================================
// r29-f：分布式文件存储（9 大条件）
//   1. 沙箱绑定强制落地（最高优先级：绑定沙箱的节点）
//   2. 上传 ≥10MB 直沉 Worker；小文件主控中转（24h TTL 后台下沉）
//   3. 共享协作文件下沉被访问端
//   4. 冷热分层（默认 30 天未访问 → COLD）
//   5. 资源水位调度（默认 20% 安全水位，超额节点不接新落盘）
//   6. 多副本 1-3（跨节点分布）
//   7. 副本修复（节点失联 LOST → 计划重建）
//   8. 跨节点迁移跟随（沙箱迁移 → 文件随迁）
//   9. 中转队列超时强制下沉
// ============================================================

model FileObject {
  id            String    @id @default(cuid()) @db.VarChar(64)
  fileKey       String    @unique @db.VarChar(400) // <sha256前16>-<安全化文件名>
  name          String @db.VarChar(255)
  sizeBytes     Int       @default(0)
  mimeType      String? @db.Text
  sha256        String? @db.Text
  // 归属语义（路由键）
  bindType      String    @default("GENERAL") @db.VarChar(255) // SANDBOX | USER | SHARE | GENERAL
  bindId        String? @db.VarChar(64)
  // 分层与副本
  tier          String    @default("HOT") @db.VarChar(255) // HOT | COLD
  replicas      Int       @default(1)
  // 上传通道与中转
  uploadChannel String    @default("MASTER_RELAY") @db.VarChar(255) // MASTER_RELAY | DIRECT_WORKER
  relayExpiresAt DateTime? // 中转 TTL（24h；到期强制下沉）
  relayed       Boolean   @default(false)
  lastAccessAt  DateTime  @default(now())
  accessNode    String? @db.Text // 最近访问节点（共享下沉判定）
  createdById   String? @db.VarChar(64)
  createdByName String? @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  placements    FilePlacement[]

  @@index([bindType, bindId])
  @@index([tier, lastAccessAt])
  @@index([relayExpiresAt])
}

model FilePlacement {
  id        String   @id @default(cuid()) @db.VarChar(64)
  fileId    String @db.VarChar(64)
  file      FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  nodeUuid  String @db.VarChar(64) // 落地节点（MASTER=主控；wn-xxx=Worker）
  role      String   @default("PRIMARY") @db.VarChar(255) // PRIMARY | REPLICA
  status    String   @default("ACTIVE") @db.VarChar(255) // ACTIVE | SYNCING | LOST | MIGRATING
  sizeBytes Int      @default(0)
  syncJobId String? @db.VarChar(64) // 下沉/同步任务（中转 24h / 副本修复）
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([nodeUuid, status])
  @@unique([fileId, nodeUuid])
}

// ============================================================
// r38：硬件透传访问申请（静默/申请双模式的申请侧）
//   · 用户申请某硬件权限（沙箱级或账号级）→ 管理员审批（GRANTED/DENIED）
//   · GRANTED + expiresAt 未过期 → resolveHardwarePolicy 视该权限为 enabled
//   · 静默模式（无提示监控）由既有 silent 开关承担；本表只管「申请→批准」链
// ============================================================
model HardwareAccessRequest {
  id           String    @id @default(cuid()) @db.VarChar(64)
  userId       String @db.VarChar(64)
  workspaceId  String? @db.VarChar(64) // 空=账号级申请（对该用户全部沙箱生效）
  permId       String @db.VarChar(64) // HARDWARE_PERMS 目录项：camera/microphone/usb/...
  mode         String    @default("PENDING") @db.VarChar(255) // PENDING | GRANTED | DENIED | EXPIRED | REVOKED
  reason       String? @db.Text // 申请理由
  scope        String    @default("self") @db.VarChar(255) // self=本人 | admin-silent=管理员静默授予
  decidedBy    String? @db.Text // 审批管理员 userId
  decidedByName String? @db.Text
  decisionNote String? @db.Text // 审批备注
  expiresAt    DateTime? // 授权有效期（空=永久直至撤销）
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([workspaceId])
  @@index([mode, expiresAt])
  @@index([permId, mode])
}

// ============================================================
// r40：远程打印机池（虚拟打印机 —— 沙箱页面 → 远程客户端物理打印机）
// 客户端（Worker/打印代理）上报本机打印机 → 用户会话内选择 → PDF 经
// 指令队列派发到目标客户端 → dialog（打印界面）/silent（lp 直打）双交付
// ============================================================

model RemotePrinter {
  id               String   @id @default(cuid()) @db.VarChar(64)
  nodeUuid         String @db.VarChar(64) // 所属客户端节点（WorkNode nodeUuid）
  printerKey       String @db.VarChar(400) // 客户端本地打印机标识（CUPS 队列名 / Win 打印机名）
  name             String @db.VarChar(255) // 展示名（型号 / 描述）
  description      String   @default("") @db.VarChar(255)
  status           String   @default("ONLINE") @db.VarChar(255) // ONLINE | OFFLINE | DISABLED
  capabilitiesJson String   @default("{}") @db.VarChar(255) // 纸张/双面/彩色能力（客户端 CUPS 探测）
  clientName       String   @default("") @db.VarChar(255) // 上报机器 hostname
  location         String   @default("") @db.VarChar(255) // 管理员标注位置（如 3F 打印区）
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@unique([nodeUuid, printerKey])
  @@index([status])
  @@index([nodeUuid])
}

model PrintJob {
  id              String    @id @default(cuid()) @db.VarChar(64)
  jobNo           String    @unique @db.VarChar(500) // 展示号 PJ-<base36 时间戳>
  workspaceId     String? @db.VarChar(64)
  workspaceName   String    @default("") @db.VarChar(255)
  userId          String @db.VarChar(64)
  username        String @db.VarChar(255)
  printerId       String? @db.VarChar(64)
  nodeUuid        String @db.VarChar(64) // 目标客户端节点
  printerKey      String @db.VarChar(400) // 目标本地打印机（冗余存储 —— 打印机被删后任务仍可追溯）
  printerName     String    @default("") @db.VarChar(255)
  sourceUrl       String    @default("") @db.VarChar(700) // 打印源页面 URL（URL 级打印策略审计依据）
  fileName        String @db.Text
  fileBytes       Int       @default(0)
  fileSha256      String    @default("") @db.VarChar(255)
  fileKey         String    @default("") @db.VarChar(400) // storage/print-jobs/<id>.pdf
  status          String    @default("PENDING") @db.VarChar(255) // PENDING | SENT | DELIVERED | PRINTING | PRINTED | FAILED | CANCELED | TIMED_OUT
  deliverMode     String    @default("dialog") @db.VarChar(255) // dialog=客户端打印界面 | silent=直打不出框
  copies          Int       @default(1)
  duplex          String    @default("default") @db.VarChar(255) // default | simplex | duplex
  landscape       Boolean   @default(false)
  printParamsJson String    @default("{}") @db.VarChar(255)
  error           String? @db.Text
  attempts        Int       @default(0)
  createdByIp     String    @default("") @db.VarChar(255)
  createdAt       DateTime  @default(now())
  sentAt          DateTime?
  deliveredAt     DateTime?
  finishedAt      DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([nodeUuid, createdAt])
}
