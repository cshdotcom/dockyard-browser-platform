// [r38] 本文件由 scripts/db/sync-mysql-schema.ts 从 schema.prisma 自动派生 —— 请勿手工编辑模型
// （模型变更请改 schema.prisma 后重新执行同步脚本；本文件仅 datasource provider 与 @db 类型标注不同）
// MySQL 兼容性：所有 String 字段注入 @db.VarChar(n)/@db.Text（Prisma MySQL 默认 VARCHAR(191) 会截断长内容）
// Dockyard — 企业级远程浏览器工作平台
// 完整数据模型：认证安全 / 组织权限 / 审计 / Token / 系统 / 定时任务 / 文件 / 备份 / 告警
// 浏览器工作区 / 模板 / 快照 / 脚本 / 规则 / 浏览器节点 / 代理 / 宿主机 / SingBox / MCP / 回收站 / 风控
// 说明：审计日志(AuditLog)仅允许 INSERT —— 应用层禁止任何 update/delete 入口；
//       PostgreSQL 部署时可执行 scripts/sql/audit_triggers.sql 施加数据库层触发器保护。

generator client {
  provider = "prisma-client-js"

  // [r38] 独立产物目录：node_modules/@prisma/client-mysql（与 sqlite/postgres client 并存）
  output   = "../node_modules/@prisma/client-mysql"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 一、用户与认证安全
// ============================================================

model User {
  id                  String    @id @default(cuid()) @db.VarChar(64)
  username            String    @unique @db.VarChar(255)
  email               String?   @unique @db.VarChar(320)
  displayName         String? @db.VarChar(255)
  avatarPath          String? @db.VarChar(700) // 用户头像存储相对路径（独立空间：storage/avatars/<userId>/avatar.webp）
  avatarUpdatedAt     DateTime? // 头像更新时间（ETag/缓存失效用）
  passwordHash        String? @db.VarChar(255)
  role                String    @default("USER") @db.VarChar(255) // SUPER_ADMIN | ADMIN | GROUP_ADMIN | USER
  enabled             Boolean   @default(true)
  emailVerified       Boolean   @default(false)
  mustChangePassword  Boolean   @default(false)
  twoFactorEnabled    Boolean   @default(false)
  force2faSetup       Boolean   @default(false) // 强制2FA策略命中标记
  managedPolicyOverrides String? @db.Text // r35：用户级 Chromium 企业策略覆盖（JSON 键值；合并链：沙箱>用户>用户组>模板）
  lockedUntil         DateTime?
  failedLoginCount    Int       @default(0)
  preferences          Json? // { pageSize, theme, columns, sidebarCollapsed }
  quota               Json? // { sessions, novncSessions, diskMb, proxyBandwidthMb }
  lastLoginAt         DateTime?
  lastLoginIp         String? @db.Text
  lastLoginCountry    String? @db.Text
  frozen              Boolean   @default(false) // 永久冻结
  permissionLocks     Json? // 用户级权限锁覆盖
  shareAllowed        Boolean? // r13c：用户级共享开关（null=继承用户组，true=强制允许，false=强制禁止）
  guestShareAllowed   Boolean? // r37：用户级访客访问开关（null=继承用户组；false=强制禁止访客接入其分享链接）
  // —— 网络访问管控（管理员按用户覆盖；null=继承所属组，组缺失时用全局默认）——
  allowInternalNetwork      Boolean? // 允许浏览器会话访问内网（RFC1918/链路本地/云元数据）
  allowSecureLocationAccess Boolean? // 允许访问容器内安全位置（CDP/VNC本机端口、file://、平台内部端点）
  // —— VNC 会话时长上限（分钟，null=继承用户组，0=不限；三级优先级：沙箱>用户>用户组）——
  vncSessionMaxMinutes      Int?
  // —— 闲置超时四级策略链（分钟；沙箱>用户>用户组>全局默认；0=无限即永不闲置回收）——
  idleTimeoutMinutes     Int? // null=继承用户组
  idleTimeoutLocked      Boolean @default(false) // true=管理员锁定：用户创建/编辑沙箱时不可自行调整闲置超时
  // —— r23：API-Key 精确管控（用户级覆盖，null=继承所属组；组也未设置时用全局默认）——
  tokenPolicy            Json? // { allowCreate, maxPerUser, allowPermanent, maxLifetimeDays, rateLimitPerMin, allowedScopes }（null字段=继承）
  // —— r27：VNC 会话录像策略（用户级覆盖；null=继承用户组/全局默认）——
  vncRecording           Boolean?
  // —— r28：回放安全策略（水印/导出；null=继承组/全局默认）{ watermark: "force"|"on"|"off", allowExport: bool }——
  vncPlayback            Json?
  // —— r28：回收站保留期（天，null=继承组/全局默认；0=永久保留）——
  recycleRetentionDays   Int?
  // —— r28：文件传输限速（KB/s，null=继承组/全局；0=不限）——
  fileTransferKBps       Int?
  // —— r29：17 项硬件权限用户级覆盖（稀疏 JSON；null=继承组/全局）——
  hardwarePolicy         Json?
  // —— r33：存储配额（用户级覆盖；null=继承用户组/全局默认；0=不限）——
  storageQuotaMb     Int? // 总配额（MB，录像+截图+云盘文件统一计入）
  storagePolicy      Json? // 稀疏覆盖 { recording?: bool, screenshot?: bool, upload?: bool, recordingMb?: int, screenshotMb?: int, fileMb?: int }（null 字段=继承）
  // —— r33：沙箱最大时长（用户级覆盖；null=继承组/全局；0=不限）——
  maxTtlMinutes      Int?
  allowUnlimitedTtl  Boolean? // 是否允许选择「无限时长」（null=继承；false 时创建必选有限时长且 ≤ maxTtlMinutes）
  loginSessionCount   Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([role])
  @@index([deletedAt])
  @@index([enabled])
  @@index([createdAt])
}

model PasswordHistory {
  id           String   @id @default(cuid()) @db.VarChar(64)
  userId       String @db.VarChar(64)
  passwordHash String @db.VarChar(255)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid()) @db.VarChar(64)
  userId     String @db.VarChar(64)
  tokenHash  String    @unique @db.VarChar(255)
  expiresAt  DateTime
  revokedAt  DateTime?
  clientIp   String? @db.Text
  userAgent  String? @db.Text
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginSession {
  id              String    @id @default(cuid()) @db.VarChar(64)
  userId          String @db.VarChar(64)
  refreshTokenId  String? @db.VarChar(64)
  sessionHash     String    @unique @db.VarChar(255)
  ip              String? @db.VarChar(64)
  userAgent       String? @db.Text
  deviceLabel     String? @db.VarChar(255)
  deviceId        String? @db.VarChar(64) // 设备指纹（哈希）
  trusted         Boolean   @default(false)
  rememberMe      Boolean   @default(false)
  expiresAt       DateTime
  idleTimeoutSec  Int       @default(1800)
  lastActiveAt    DateTime  @default(now())
  revokedAt       DateTime?
  revokedReason   String? @db.Text // LOGOUT | PASSWORD_CHANGE | ADMIN_KICK | IDLE_TIMEOUT | EXPIRED | SECURITY
  createdAt       DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([lastActiveAt])
}

model TrustedDevice {
  id         String    @id @default(cuid()) @db.VarChar(64)
  userId     String @db.VarChar(64)
  deviceId   String @db.VarChar(64)
  label      String? @db.VarChar(255)
  ua         String? @db.Text
  ip         String? @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

model EmailVerificationCode {
  id          String    @id @default(cuid()) @db.VarChar(64)
  email       String @db.VarChar(320)
  codeHash    String @db.VarChar(255)
  purpose     String @db.VarChar(255) // LOGIN | REGISTER | RESET_PASSWORD | CHANGE_EMAIL_OLD | CHANGE_EMAIL_NEW
  userId      String? @db.VarChar(64)
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  sentAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model TotpSecret {
  id               String   @id @default(cuid()) @db.VarChar(64)
  userId           String   @unique @db.VarChar(64)
  secretEncrypted  String @db.VarChar(255) // AES-256-GCM 加密，绝不明文落盘
  confirmed        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid()) @db.VarChar(64)
  userId    String @db.VarChar(64)
  codeHash  String @db.VarChar(255)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 安全事件（登录成功/失败、2FA、密码修改、邮箱变更、设备下线、管理员安全重置）
model SecurityEvent {
  id         String   @id @default(cuid()) @db.VarChar(64)
  userId     String? @db.VarChar(64)
  username   String? @db.VarChar(255)
  eventType  String @db.VarChar(300)
  success    Boolean  @default(true)
  ip         String? @db.VarChar(64)
  userAgent  String? @db.Text
  detail     String? @db.Text
  traceId    String? @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

// ============================================================
// 二、用户组与组织
// ============================================================

model Group {
  id               String   @id @default(cuid()) @db.VarChar(64)
  name             String   @unique @db.VarChar(255)
  description      String? @db.Text
  parentId         String? @db.VarChar(64)
  enabled          Boolean  @default(true)
  inheritParentQuota Boolean @default(true)
  quota            Json? // { sessions, novncSessions, diskMb, proxyBandwidthMb, reservedSessions, reservedNovnc }
  reservedQuota    Json? // 预留资源水位
  tags             Json? // ["标签"]
  webhookUrl       String? @db.VarChar(700)
  force2fa         Boolean  @default(false) // 组级强制2FA
  managedPolicyOverrides String? @db.Text // r35：组级 Chromium 企业策略覆盖（JSON 键值；合并链：沙箱>用户>用户组>模板）
  allowShare       Boolean  @default(true) // r13c：组级共享开关（false=组内成员默认禁止共享工作区；用户级可覆盖）
  allowGuestShare  Boolean  @default(true) // r37：组级访客访问开关（false=组内成员创建的分享链接不允许访客接入；用户级可覆盖）
  allowInternalNetwork       Boolean  @default(false) // 组级：允许访问内网（成员默认继承）
  allowSecureLocationAccess  Boolean  @default(false) // 组级：允许访问容器内安全位置
  vncSessionMaxMinutes       Int? // 组级 VNC 会话时长上限（分钟，null=继承全局默认，0=不限）
  idleTimeoutMinutes         Int? // 组级闲置超时（分钟，null=继承全局默认，0=无限）
  idleTimeoutLocked          Boolean @default(false) // true=组内成员不可自行调整闲置超时（沙箱级仍可由管理员改）
  policy           Json? // 组级权限锁 / 生命周期默认策略
  // —— r23：API-Key 精确管控（组级基线；用户级 tokenPolicy 可覆盖，均未设置时用全局默认）——
  tokenPolicy      Json? // { allowCreate, maxPerUser, allowPermanent, maxLifetimeDays, rateLimitPerMin, allowedScopes }（null字段=继承）
  // —— r27：VNC 会话录像组级基线（null=继承全局默认）——
  vncRecording     Boolean?
  // —— r28：回放安全组级基线 { watermark, allowExport }（null=继承全局默认）——
  vncPlayback      Json?
  // —— r28：回收站保留期组级基线（天，null=继承全局默认；0=永久保留）——
  recycleRetentionDays Int?
  // —— r28：文件传输限速组级基线（KB/s，null=继承全局；0=不限）——
  fileTransferKBps Int?
  // —— r29：17 项硬件权限组级基线（稀疏 JSON；null=继承父组/全局）——
  hardwarePolicy  Json?
  // —— r33：存储配额组级基线（null=继承全局；0=不限；用户级可覆盖）——
  storageQuotaMb     Int? // 总配额（MB）
  storagePolicy      Json? // { recording?: bool, screenshot?: bool, upload?: bool, recordingMb?: int, screenshotMb?: int, fileMb?: int }
  // —— r33：沙箱最大时长组级基线（null=继承全局；0=不限；用户级可覆盖）——
  maxTtlMinutes      Int?
  allowUnlimitedTtl  Boolean?
  createdByUserId  String? @db.VarChar(64)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  @@index([parentId])
  @@index([deletedAt])
}

model GroupUser {
  id        String   @id @default(cuid()) @db.VarChar(64)
  groupId   String @db.VarChar(64)
  userId    String @db.VarChar(64)
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupAdmin {
  id             String   @id @default(cuid()) @db.VarChar(64)
  groupId        String @db.VarChar(64)
  userId         String @db.VarChar(64)
  canModifyQuota Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([groupId, userId])
}

model GroupProxy {
  id           String   @id @default(cuid()) @db.VarChar(64)
  groupId      String @db.VarChar(64)
  proxyNodeId  String @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@unique([groupId, proxyNodeId])
}

// ============================================================
// 三、审计日志（只插入，禁止修改删除）
// ============================================================

model AuditLog {
  id             String   @id @default(cuid()) @db.VarChar(64)
  traceId        String? @db.VarChar(64)
  operatorUserId String? @db.VarChar(64)
  operatorName   String? @db.VarChar(255)
  operationType  String @db.VarChar(500)
  resourceType   String @db.VarChar(300)
  resourceId     String? @db.VarChar(64)
  resourceName   String? @db.VarChar(255)
  ownerUserId    String? @db.VarChar(64) // 资源当前所有者
  createdByUserId String? @db.VarChar(64) // 资源原始创建人
  clientIp       String? @db.Text
  userAgent      String? @db.Text
  severity       String   @default("INFO") @db.VarChar(255) // INFO | WARN | CRITICAL | DANGER
  beforeJson     String? @db.MediumText
  afterJson      String? @db.MediumText
  extraJson      String? @db.MediumText
  createdAt      DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([operatorUserId, createdAt])
  @@index([createdAt])
  @@index([operationType])
}

model AuditLogArchive {
  id             String   @id @default(cuid()) @db.VarChar(64)
  originId       String @db.VarChar(64)
  traceId        String? @db.VarChar(64)
  operatorUserId String? @db.VarChar(64)
  operatorName   String? @db.VarChar(255)
  operationType  String @db.Text
  resourceType   String @db.VarChar(300)
  resourceId     String? @db.VarChar(64)
  resourceName   String? @db.VarChar(255)
  ownerUserId    String? @db.VarChar(64)
  createdByUserId String? @db.VarChar(64)
  clientIp       String? @db.Text
  severity       String? @db.VarChar(255)
  beforeJson     String? @db.MediumText
  afterJson      String? @db.MediumText
  extraJson      String? @db.MediumText
  archivedAt     DateTime @default(now())
  createdAt      DateTime

  @@index([resourceType, resourceId])
}

// ============================================================
// 四、API-Token
// ============================================================

model ApiToken {
  id             String    @id @default(cuid()) @db.VarChar(64)
  userId         String @db.VarChar(64)
  name           String @db.VarChar(255)
  tokenHash      String    @unique @db.VarChar(255)
  tokenPrefix    String @db.VarChar(255) // 前8位用于辨识
  permissionsMask Int      @default(0)
  // 功能范围（scope 白名单）：null/[] = 不限（全部授权范围）；
  // 非空数组 = 仅允许调用命中数组内 scope 的功能面（browser/proxy/user/token/recycle/session/crx/resources）
  scopes         Json?
  ipWhitelist    Json?
  qpsLimit       Float     @default(0) // 0 = 全局默认
  rateLimitPerMin Int? // r23：每Key每分钟调用上限覆盖（null=继承策略链：用户/组/全局 mcp.perKeyPerMinute）
  expireAt       DateTime? // null = 永久
  enabled        Boolean   @default(true)
  lastCallAt     DateTime?
  callCount      Int       @default(0)
  failCount      Int       @default(0)
  createdByUserId String? @db.VarChar(64)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([userId, deletedAt])
  @@index([expireAt])
}

model ApiTokenCallLog {
  id           String   @id @default(cuid()) @db.VarChar(64)
  tokenId      String? @db.VarChar(64)
  tokenUserId  String? @db.VarChar(64)
  path         String @db.Text
  method       String @db.VarChar(255)
  status       Int
  durationMs   Int
  wasExpired   Boolean  @default(false) // 调用时Token是否已过期
  ip           String? @db.VarChar(64)
  traceId      String? @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@index([tokenId, createdAt])
  @@index([tokenUserId, createdAt])
  @@index([createdAt])
}

// ============================================================
// 五、系统配置 / 定时任务 / 幂等
// ============================================================

model SystemConfig {
  key          String   @id @db.VarChar(400)
  valueJson    String @db.MediumText
  category     String   @default("GENERAL") @db.VarChar(255) // SECURITY | SESSION | STORAGE | ALERT | NETWORK | UI | GENERAL | MCP
  valueType    String   @default("string") @db.VarChar(255) // string | number | boolean | json
  description  String? @db.Text
  version      Int      @default(1)
  updatedByUserId String? @db.VarChar(64)
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model ConfigVersion {
  id             String   @id @default(cuid()) @db.VarChar(64)
  configKey      String @db.VarChar(400)
  version        Int
  beforeJson     String? @db.MediumText
  afterJson      String? @db.MediumText
  operatorUserId String? @db.VarChar(64)
  createdAt      DateTime @default(now())

  @@index([configKey, version])
}

model ScheduleTask {
  code             String   @id @db.VarChar(500)
  name             String @db.VarChar(255)
  cronExpr         String @db.Text
  enabled          Boolean  @default(true)
  timeoutSec       Int      @default(300)
  dependsOn        String? @db.Text // 依赖任务code
  consecutiveFails Int      @default(0)
  lastExecuteAt    DateTime?
  lastResult       String? @db.Text
  avgDurationMs    Int      @default(0)
  // —— r23：自定时任务（管理员可创建/编辑/删除的自定义调度，基于内置任务类型注册表）——
  isCustom         Boolean  @default(false) // true=自定义任务（code 形如 custom:<cuid>）
  taskType         String? @db.Text // 执行的任务类型（TASKS 注册表键；内置任务=null 即用 code 本身）
  paramsJson       String? @db.MediumText // 任务参数（预留，目前注册表任务无参数）
  description      String? @db.Text // 自定义任务备注说明
  createdByUserId  String? @db.VarChar(64) // 创建人（自定义任务审计追溯）
  nextRunAt        DateTime? // r23：按 cron 表达式计算的下次到期时间（到期调度器/接口据此触发）
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ScheduleTaskLog {
  id          String   @id @default(cuid()) @db.VarChar(64)
  taskCode    String @db.VarChar(300)
  triggerType String   @default("CRON") @db.VarChar(255) // CRON | MANUAL
  status      String   @default("RUNNING") @db.VarChar(255) // RUNNING | SUCCESS | FAILED | TIMEOUT
  startAt     DateTime @default(now())
  endAt       DateTime?
  durationMs  Int?
  errorStack  String? @db.Text
  summary     String? @db.Text
  itemsProcessed Int  @default(0)
  outputJson  String? @db.MediumText // r24-a：参数化执行体完整输出（脚本 stdout / 响应体，上限 64KB）

  @@index([taskCode, startAt])
  @@index([status])
  @@index([startAt])
}

// —— r23：IP 自动封禁（登录/API-Key 连续失败计数 → 定时封禁；与手工 RiskListRule 黑名单互补）——
model IpBanRecord {
  id            String    @id @default(cuid()) @db.VarChar(64)
  ip            String @db.VarChar(64)
  source        String    @default("LOGIN") @db.VarChar(255) // LOGIN | API_KEY | MANUAL
  failCount     Int       @default(0) // 窗口内累计失败次数
  firstFailAt   DateTime?
  lastFailAt    DateTime?
  bannedUntil   DateTime? // null=当前未封禁（仅计数）；非空=封禁生效中
  reason        String? @db.Text // 封禁原因
  note          String? @db.Text // 管理员备注（手动封禁/解封说明）
  createdByUserId String? @db.VarChar(64) // 手动封禁操作人
  unbannedByUserId String? @db.VarChar(64) // 手动解封操作人
  unbannedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([ip])
  @@index([bannedUntil])
  @@index([lastFailAt])
}

model IdempotencyRecord {
  id          String   @id @default(cuid()) @db.VarChar(64)
  fingerprint String   @unique @db.VarChar(255)
  userId      String? @db.VarChar(64)
  action      String @db.VarChar(255)
  resultJson  String? @db.MediumText
