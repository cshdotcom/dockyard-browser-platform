model Announcement {
  id             String   @id @default(cuid()) @db.VarChar(64)
  title          String @db.VarChar(255)
  content        String @db.MediumText
  type           String   @default("GLOBAL") @db.VarChar(255) // GLOBAL | GROUP | USER（范围多选时的主类型：仅组=GROUP / 含用户=USER / 空=GLOBAL）
  groupId        String? @db.VarChar(64) // 兼容字段：主组（= groupIds 首项；旧单选数据即此字段）
  userId         String? @db.VarChar(64) // 兼容字段：主用户（= userIds 首项；旧单选数据即此字段）
  groupIdsJson   String? @db.MediumText // r30 范围多选：目标用户组 JSON 数组（如 ["gid1","gid2"]；空=未选组）
  userIdsJson    String? @db.MediumText // r30 范围多选：目标用户 JSON 数组（可与 groupIdsJson 组合=组+用户混合范围）
  displayType    String   @default("POPUP") @db.VarChar(255) // POPUP | MARQUEE | FORCE_VIEW（主展示方式 = displayTypes 首项，兼容旧数据）
  displayTypes   String? @db.Text // 多选展示方式（JSON 数组，如 ["POPUP","MARQUEE"]；空数组=仅站内信）
  notifyInbox    Boolean  @default(false) // 站内信通道（发送到用户通知铃/站内信）
  notifiedAt     DateTime? // 站内信已投递时间（幂等防重发：投递一次后永不重发）
  startAt        DateTime? // 显示开始时间（null=立即显示；未到开始时间不展示）
  endAt          DateTime? // 结束时间（null=永久；过期后不再展示，站内信保留可回看）
  persistAfterRead Boolean @default(false) // 已读后持续显示（弹窗每次刷新仍弹出，除非勾选今日不再提醒）
  allowDismiss   Boolean  @default(true) // 允许用户勾选「今日不再提醒」（管理员可控；跑马灯的今日不显示同样受控）
  enabled        Boolean  @default(true)
  createdByUserId String? @db.VarChar(64)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, enabled])
  @@index([enabled, endAt])
}

