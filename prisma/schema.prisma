  locked            Boolean   @default(false) // 锁定保护
  overrideMinutes   Int?      // r28：管理员单条覆盖保留期（分钟；null=策略链解析值）
  recoverDeadline   DateTime? // 恢复时效限制
  purgeAt           DateTime? // 物理清除时间
  restoredAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([resourceType, resourceId])
  @@index([ownerUserId])
  @@index([purgeAt])
}

// ============================================================
// r28：文件分享链接（有效期/权限模式/次数/限速）
// ============================================================

model FileShareLink {
  id             String    @id @default(cuid())
  token          String    @unique
  domain         String    @default("STORAGE") // ROOT_FS | STORAGE
  filePath       String    // 域内相对路径
  fileName       String
  sizeBytes      Int       @default(0)
  isDir          Boolean   @default(false) // r31：文件夹分享（预览页目录浏览/zip 打包）
  ownerUserId    String
  accessMode     String    @default("LOGIN") // PUBLIC(免登录) | LOGIN(需登录) | USERS(指定用户/组)
  allowedUsers   Json?     // { userIds: [], groupIds: [] } 名单（USERS 模式）
  expiresAt      DateTime? // null = 永久有效
  maxViews       Int?      // null = 不限查看次数
  maxDownloads   Int?      // null = 不限下载次数
  downloadKBps   Int?      // null = 继承用户/全局限速
  viewCount      Int       @default(0)
  downloadCount  Int       @default(0)
  note           String?
  revokedAt      DateTime?
