  userId        String?
  guid          String?   // Chromium 书签 GUID
  url           String
  title         String?
  folder        String?   // 所在文件夹路径（如 书签栏/工作）
  category      String?   // r37：数据自动分类（同 BrowseHistoryEntry）
  sensitivity   String?   // r37：敏感级别（同 BrowseHistoryEntry）
  position      Int       @default(0)
  dateAdded     DateTime?
  removedAt     DateTime? // 用户删除时标记（upsert 对账）
  lastSyncAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@unique([workspaceId, guid])
  @@index([userId])
  @@index([url])
  @@index([workspaceId, removedAt])
  @@index([category])
}

model RecycleBin {
  id                String    @id @default(cuid())
  resourceType      String
  resourceId        String
  resourceName      String?
  ownerUserId       String?
  createdByUserId   String?
  deletedByUserId   String?
