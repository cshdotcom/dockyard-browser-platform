model ResourceLifecycleRule {
  id             String   @id @default(cuid())
  resourceType   String
  resourceId     String?
  scopeType      String   @default("RESOURCE") // RESOURCE | GROUP | GLOBAL
  scopeId        String?
  rulesJson      String // { autoPauseAt, autoFreezeAt, autoExpireAt, autoRecycleAt, autoDeleteAt }
  enabled        Boolean  @default(true)
  createdByUserId String?
  createdAt      DateTime @default(now())
}

model SystemSelfCheck {
  id          String   @id @default(cuid())
  checkCode   String
  status      String   @default("PASS") // PASS | WARN | FAIL | FIXED
  detail      String?
  fixedAction String?
  createdAt   DateTime @default(now())

  @@index([checkCode, createdAt])
}

// ============================================================
// CRX 扩展管控体系（企业浏览器后台 · 零内核 Patch · Managed Preferences 原生策略）
// 约束：后台不存 CRX 二进制，只维护扩展 ID + update_url 元数据；
//      全部依赖 Chromium ExtensionInstallForcelist / Blocklist / ExtensionSettings 原生策略
// ============================================================

// CRX 插件资源库（元数据库；所有下发沙箱的插件必须先录入）
model CrxPlugin {
  id                 String    @id @default(cuid())
  crxId              String    @unique // Chrome/Edge 商店真实 32 位扩展 ID
  name               String
  description        String?
  zhNote             String? // 中文备注
  tags               Json? // 业务标签 ["office","dev","ops","highrisk"]
  permissions        Json? // manifest 权限清单（自动导入 / 手动录入）
  updateUrl          String // 主安装源 update_url
  backupUpdateUrl    String? // 备用安装源（降级）
  lockedVersion      String? // 强制锁定版本（禁止自动升级）
  allowIncognito     Boolean   @default(false) // 允许无痕运行（全局默认，下发可覆盖）
  allowUserDisable   Boolean   @default(true) // false=用户沙箱内不能禁用（force_installed）
  highRisk           Boolean   @default(false) // 高危标记（按 manifest 权限自动判定）
  highRiskReason     Json? // ["all_urls","clipboardRead",...]
  enabled            Boolean   @default(true) // 库内禁用：禁用后所有继承沙箱不再安装
  docUrl             String? // 内部文档链接
  createdByUserId    String?
  createdByName      String?
  updatedByUserId    String?
  updatedByName      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? // 软删（插件库回收站）
  deletedByUserId    String?
  deletedByName      String?

  @@index([deletedAt])
  @@index([enabled])
  @@index([highRisk])
  @@index([createdAt])
}

// 五级 CRX 策略条目（强制安装列表项：GLOBAL / GROUP / USER / SANDBOX 层）
model CrxPolicyEntry {
  id               String    @id @default(cuid())
  scopeType        String // GLOBAL | GROUP | USER | SANDBOX
  scopeId          String? // 对应 groupId/userId/workspaceId（GLOBAL 为空）
  crxId            String
  updateUrl        String? // 覆盖主源
  backupUpdateUrl  String? // 覆盖备用源
  lockedVersion    String? // 覆盖锁定版本
  allowIncognito   Boolean? // 覆盖无痕运行
  allowUserDisable Boolean? // 覆盖可禁用
  note             String?
  createdByUserId  String?
  createdByName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@unique([scopeType, scopeId, crxId])
  @@index([scopeType, scopeId])
  @@index([crxId])
}

// CRX 黑名单（强制禁止安装；GLOBAL 层为主，黑名单不随继承开关失效）
model CrxBlocklistEntry {
  id              String   @id @default(cuid())
  scopeType       String // GLOBAL | GROUP | USER | SANDBOX
  scopeId         String?
  crxId           String
  note            String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())

  @@unique([scopeType, scopeId, crxId])
  @@index([crxId])
}

// 沙箱逐插件安装状态（安装调度状态机）
model CrxInstallStatus {
  id              String    @id @default(cuid())
  workspaceId     String
  crxId           String
  state           String    @default("PENDING") // PENDING | POLICY_APPLIED | INSTALLED | PRIMARY_FAILED | BACKUP_RETRY | ALL_FAILED | VERSION_MISMATCH
  sourceUsed      String? // 当前使用的源（主/备）
  currentVersion  String? // 实际安装版本（CDP 检测）
  attempts        Int       @default(0)
  lastErrorCode   String?
  lastErrorAt     DateTime?
  lastCheckedAt   DateTime?
  resolvedBy      String? // SANDBOX | USER | GROUP | GLOBAL | LIBRARY
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, crxId])
  @@index([workspaceId])
  @@index([state])
  @@index([crxId])
}

// CRX 灰度下发任务（分批推送 + 一键回滚；回滚仅超级管理员）
// ============================================================
// r27：VNC 会话录像（企业级录屏审计）
// 生命周期：沙箱启动（策略四级链命中）→ 沙箱进程树内 ffmpeg x11grab 分段
// 落盘到用户空间 storage/recordings/<userId>/<sandboxId>/seg-NNN.mp4 →
// 平台扫描任务发现分段并入库（RECORDING→COMPLETED）→ 后台/用户空间回放
// （HTTP Range 流）→ 软删入回收站 → 恢复/物理清除；保留期与配额由
// 定时任务自动执行。分组语义：sessionId = 沙箱进程树 id（一次"启动→停止"
// = 一组录像会话，组内按 segmentIndex 分段，浏览器进程自愈重启不中断）。
// ============================================================
model VncRecording {
  id             String    @id @default(cuid())
  workspaceId    String
  workspaceUuid  String?   // 冗余（工作区删除后仍可溯源）
  workspaceName  String    // 冗余同上（列表可读）
  userId         String    // 归属用户（录像文件存其用户空间）
  username       String?   // 冗余（用户删除后可读）
  sessionId      String    // 录像会话组（= 沙箱进程树 id emb-*/dy-browser-*）
  segmentIndex   Int       @default(0) // 组内分段序号（0 起）
  status         String    @default("RECORDING") // RECORDING | COMPLETED | FAILED
  trigger        String    @default("AUTO") // AUTO（策略自动开录）| MANUAL（管理员手动取证）
  startedAt      DateTime  @default(now()) // 本段开始
  endedAt        DateTime? // 本段结束（扫描/终结时回填）
  durationSec    Int       @default(0)
  sizeBytes      Int       @default(0)
  storageKey     String?   // 相对 storage 根路径（recordings/<userId>/<sessionId>/seg-NNN.mp4）
  resolution     String?
  fps            Int       @default(12)
  policySource   String?   // 录像策略命中层（SANDBOX|USER|GROUP|GLOBAL_DEFAULT）
  note           String?
  viewCount      Int       @default(0)
  lastViewedAt   DateTime?
  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  metadata       Json?     // 溯源（模板/策略快照/浏览器版本等）
  deletedAt      DateTime? // 软删 → 回收站
  purgeAt        DateTime? // 物理清除计划时间（保留期到期）
  restoredAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sessionId, segmentIndex]) // 幂等：补行/注册双通道不会产生重复分段行
  @@index([userId, deletedAt])
  @@index([workspaceId])
  @@index([status, deletedAt])
  @@index([deletedAt, purgeAt])
  @@index([createdAt])
}

model CrxGrayTask {
  id              String    @id @default(cuid())
  name            String
  entriesJson     String // [{ crxId, updateUrl?, lockedVersion?, allowIncognito?, allowUserDisable? }]
  targetIds       Json // [workspaceId,...] 灰度目标沙箱
  status          String    @default("PENDING") // PENDING | ROLLING | SUCCESS | PARTIAL | ROLLED_BACK | CANCELLED
  batchSize       Int       @default(3)
  total           Int       @default(0)
  progressed      Int       @default(0)
  successCount    Int       @default(0)
  failCount       Int       @default(0)
  rollbackReason  String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime  @default(now())
  activatedAt     DateTime?
  finishedAt      DateTime?

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// r29-b：硬件远程监视授权（双模式）
//   CONSENT 知情模式 —— 用户 VNC 顶部横幅（红点+一键切断）
//   SILENT  静默特权模式 —— 仅超管可授予；对用户完全无感知；强制审计
// ============================================================

model MonitorGrant {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String? // 被监控用户（冗余，展示与筛选）
  channel         String // camera | microphone | screenShare
  mode            String // CONSENT | SILENT
  reason          String? // 授权理由（SILENT 必填）
  grantedByUserId String
  grantedByName   String
  active          Boolean   @default(true)
  cutOffBy        String? // USER_CUTOFF | ADMIN_REVOKE | SESSION_END
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, active])
  @@index([active, mode])
  @@index([userId, active])
}

// ============================================================
// r29-e：虚拟媒体投递（云盘音视频定点秒级投递 + 图片恒定帧虚拟摄像头）
// ============================================================

model MediaCast {
  id                 String    @id @default(cuid())
  workspaceId        String
  userId             String?
  fileName           String
  mediaKind          String // video | audio
  seekSec            Int       @default(0) // 定点秒
  storagePath        String? // 沙箱内投递文件路径（重置即清理）
  castPid            Int? // ffplay 进程（存活巡检自动收口）
  status             String    @default("PLAYING") // PLAYING | STOPPED
  stopReason         String? // RESET | REPLACE | EXITED
  deliveredByUserId  String?
  deliveredByName    String?
  startedAt          DateTime  @default(now())
  stoppedAt          DateTime?

  @@index([workspaceId, status])
  @@index([status])
}

// ============================================================
// r29-f：分布式文件存储（9 大条件）
//   1. 沙箱绑定强制落地（最高优先级：绑定沙箱的节点）
//   2. 上传 ≥10MB 直沉 Worker；小文件主控中转（24h TTL 后台下沉）
//   3. 共享协作文件下沉被访问端
//   4. 冷热分层（默认 30 天未访问 → COLD）
//   5. 资源水位调度（默认 20% 安全水位，超额节点不接新落盘）
//   6. 多副本 1-3（跨节点分布）
//   7. 副本修复（节点失联 LOST → 计划重建）
//   8. 跨节点迁移跟随（沙箱迁移 → 文件随迁）
//   9. 中转队列超时强制下沉
// ============================================================

model FileObject {
  id            String    @id @default(cuid())
  fileKey       String    @unique // <sha256前16>-<安全化文件名>
  name          String
  sizeBytes     Int       @default(0)
  mimeType      String?
  sha256        String?
  // 归属语义（路由键）
  bindType      String    @default("GENERAL") // SANDBOX | USER | SHARE | GENERAL
  bindId        String?
  // 分层与副本
  tier          String    @default("HOT") // HOT | COLD
  replicas      Int       @default(1)
  // 上传通道与中转
  uploadChannel String    @default("MASTER_RELAY") // MASTER_RELAY | DIRECT_WORKER
  relayExpiresAt DateTime? // 中转 TTL（24h；到期强制下沉）
  relayed       Boolean   @default(false)
  lastAccessAt  DateTime  @default(now())
  accessNode    String? // 最近访问节点（共享下沉判定）
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  placements    FilePlacement[]

  @@index([bindType, bindId])
  @@index([tier, lastAccessAt])
  @@index([relayExpiresAt])
}

model FilePlacement {
  id        String   @id @default(cuid())
  fileId    String
  file      FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  nodeUuid  String // 落地节点（MASTER=主控；wn-xxx=Worker）
  role      String   @default("PRIMARY") // PRIMARY | REPLICA
  status    String   @default("ACTIVE") // ACTIVE | SYNCING | LOST | MIGRATING
  sizeBytes Int      @default(0)
  syncJobId String? // 下沉/同步任务（中转 24h / 副本修复）
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([nodeUuid, status])
  @@unique([fileId, nodeUuid])
}
