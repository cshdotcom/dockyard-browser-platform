  sensitivity   String?   // r37：敏感级别（NORMAL/SENSITIVE/HIGH）—— 银行/政府/邮箱等明文数据识别
  visitAt       DateTime  @default(now())
  dwellMs       Int       @default(0) // 停留时长（同 URL 连续访问合并累计）
  incognitoHint Boolean   @default(false)
  source        String    @default("CDP_POLL") // CDP_POLL | MANUAL
  deletedAt     DateTime? // 用户本地删除标记（审计另有归档）
  createdAt     DateTime  @default(now())

  @@index([workspaceId, visitAt])
  @@index([userId, visitAt])
  @@index([domain])
  @@index([url])
  @@index([category])
  @@index([sensitivity])
}

model BookmarkEntry {
