// Dockyard — 企业级远程浏览器工作平台
// 完整数据模型：认证安全 / 组织权限 / 审计 / Token / 系统 / 定时任务 / 文件 / 备份 / 告警
// 浏览器工作区 / 模板 / 快照 / 脚本 / 规则 / 浏览器节点 / 代理 / 宿主机 / SingBox / MCP / 回收站 / 风控
// 说明：审计日志(AuditLog)仅允许 INSERT —— 应用层禁止任何 update/delete 入口；
//       PostgreSQL 部署时可执行 scripts/sql/audit_triggers.sql 施加数据库层触发器保护。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 一、用户与认证安全
// ============================================================

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  email               String?   @unique
  displayName         String?
  avatarPath          String?   // 用户头像存储相对路径（独立空间：storage/avatars/<userId>/avatar.webp）
  avatarUpdatedAt     DateTime? // 头像更新时间（ETag/缓存失效用）
  passwordHash        String?
  role                String    @default("USER") // SUPER_ADMIN | ADMIN | GROUP_ADMIN | USER
  enabled             Boolean   @default(true)
  emailVerified       Boolean   @default(false)
  mustChangePassword  Boolean   @default(false)
  twoFactorEnabled    Boolean   @default(false)
  force2faSetup       Boolean   @default(false) // 强制2FA策略命中标记
  managedPolicyOverrides String? // r35：用户级 Chromium 企业策略覆盖（JSON 键值；合并链：沙箱>用户>用户组>模板）
  lockedUntil         DateTime?
  failedLoginCount    Int       @default(0)
  preferences          Json? // { pageSize, theme, columns, sidebarCollapsed }
  quota               Json? // { sessions, novncSessions, diskMb, proxyBandwidthMb }
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastLoginCountry    String?
  frozen              Boolean   @default(false) // 永久冻结
  permissionLocks     Json? // 用户级权限锁覆盖
  shareAllowed        Boolean? // r13c：用户级共享开关（null=继承用户组，true=强制允许，false=强制禁止）
  guestShareAllowed   Boolean? // r37：用户级访客访问开关（null=继承用户组；false=强制禁止访客接入其分享链接）
  // —— 网络访问管控（管理员按用户覆盖；null=继承所属组，组缺失时用全局默认）——
  allowInternalNetwork      Boolean? // 允许浏览器会话访问内网（RFC1918/链路本地/云元数据）
  allowSecureLocationAccess Boolean? // 允许访问容器内安全位置（CDP/VNC本机端口、file://、平台内部端点）
  // —— VNC 会话时长上限（分钟，null=继承用户组，0=不限；三级优先级：沙箱>用户>用户组）——
  vncSessionMaxMinutes      Int?
  // —— 闲置超时四级策略链（分钟；沙箱>用户>用户组>全局默认；0=无限即永不闲置回收）——
  idleTimeoutMinutes     Int? // null=继承用户组
  idleTimeoutLocked      Boolean @default(false) // true=管理员锁定：用户创建/编辑沙箱时不可自行调整闲置超时
  // —— r23：API-Key 精确管控（用户级覆盖，null=继承所属组；组也未设置时用全局默认）——
  tokenPolicy            Json? // { allowCreate, maxPerUser, allowPermanent, maxLifetimeDays, rateLimitPerMin, allowedScopes }（null字段=继承）
  // —— r27：VNC 会话录像策略（用户级覆盖；null=继承用户组/全局默认）——
  vncRecording           Boolean?
  // —— r28：回放安全策略（水印/导出；null=继承组/全局默认）{ watermark: "force"|"on"|"off", allowExport: bool }——
  vncPlayback            Json?
  // —— r28：回收站保留期（天，null=继承组/全局默认；0=永久保留）——
  recycleRetentionDays   Int?
  // —— r28：文件传输限速（KB/s，null=继承组/全局；0=不限）——
  fileTransferKBps       Int?
  // —— r29：17 项硬件权限用户级覆盖（稀疏 JSON；null=继承组/全局）——
  hardwarePolicy         Json?
  // —— r33：存储配额（用户级覆盖；null=继承用户组/全局默认；0=不限）——
  storageQuotaMb     Int? // 总配额（MB，录像+截图+云盘文件统一计入）
  storagePolicy      Json? // 稀疏覆盖 { recording?: bool, screenshot?: bool, upload?: bool, recordingMb?: int, screenshotMb?: int, fileMb?: int }（null 字段=继承）
  // —— r33：沙箱最大时长（用户级覆盖；null=继承组/全局；0=不限）——
  maxTtlMinutes      Int?
  allowUnlimitedTtl  Boolean? // 是否允许选择「无限时长」（null=继承；false 时创建必选有限时长且 ≤ maxTtlMinutes）
  loginSessionCount   Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([role])
  @@index([deletedAt])
  @@index([enabled])
  @@index([createdAt])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  clientIp   String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginSession {
  id              String    @id @default(cuid())
  userId          String
  refreshTokenId  String?
  sessionHash     String    @unique
  ip              String?
  userAgent       String?
  deviceLabel     String?
  deviceId        String? // 设备指纹（哈希）
  trusted         Boolean   @default(false)
  rememberMe      Boolean   @default(false)
  expiresAt       DateTime
  idleTimeoutSec  Int       @default(1800)
  lastActiveAt    DateTime  @default(now())
  revokedAt       DateTime?
  revokedReason   String? // LOGOUT | PASSWORD_CHANGE | ADMIN_KICK | IDLE_TIMEOUT | EXPIRED | SECURITY
  createdAt       DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([lastActiveAt])
}

model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  deviceId   String
  label      String?
  ua         String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

model EmailVerificationCode {
  id          String    @id @default(cuid())
  email       String
  codeHash    String
  purpose     String // LOGIN | REGISTER | RESET_PASSWORD | CHANGE_EMAIL_OLD | CHANGE_EMAIL_NEW
  userId      String?
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  sentAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model TotpSecret {
  id               String   @id @default(cuid())
  userId           String   @unique
  secretEncrypted  String // AES-256-GCM 加密，绝不明文落盘
  confirmed        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 安全事件（登录成功/失败、2FA、密码修改、邮箱变更、设备下线、管理员安全重置）
model SecurityEvent {
  id         String   @id @default(cuid())
  userId     String?
  username   String?
  eventType  String
  success    Boolean  @default(true)
  ip         String?
  userAgent  String?
  detail     String?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

// ============================================================
// 二、用户组与组织
// ============================================================

model Group {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  parentId         String?
  enabled          Boolean  @default(true)
  inheritParentQuota Boolean @default(true)
  quota            Json? // { sessions, novncSessions, diskMb, proxyBandwidthMb, reservedSessions, reservedNovnc }
  reservedQuota    Json? // 预留资源水位
  tags             Json? // ["标签"]
  webhookUrl       String?
  force2fa         Boolean  @default(false) // 组级强制2FA
  managedPolicyOverrides String? // r35：组级 Chromium 企业策略覆盖（JSON 键值；合并链：沙箱>用户>用户组>模板）
  allowShare       Boolean  @default(true) // r13c：组级共享开关（false=组内成员默认禁止共享工作区；用户级可覆盖）
  allowGuestShare  Boolean  @default(true) // r37：组级访客访问开关（false=组内成员创建的分享链接不允许访客接入；用户级可覆盖）
  allowInternalNetwork       Boolean  @default(false) // 组级：允许访问内网（成员默认继承）
  allowSecureLocationAccess  Boolean  @default(false) // 组级：允许访问容器内安全位置
  vncSessionMaxMinutes       Int? // 组级 VNC 会话时长上限（分钟，null=继承全局默认，0=不限）
  idleTimeoutMinutes         Int? // 组级闲置超时（分钟，null=继承全局默认，0=无限）
  idleTimeoutLocked          Boolean @default(false) // true=组内成员不可自行调整闲置超时（沙箱级仍可由管理员改）
  policy           Json? // 组级权限锁 / 生命周期默认策略
  // —— r23：API-Key 精确管控（组级基线；用户级 tokenPolicy 可覆盖，均未设置时用全局默认）——
  tokenPolicy      Json? // { allowCreate, maxPerUser, allowPermanent, maxLifetimeDays, rateLimitPerMin, allowedScopes }（null字段=继承）
  // —— r27：VNC 会话录像组级基线（null=继承全局默认）——
  vncRecording     Boolean?
  // —— r28：回放安全组级基线 { watermark, allowExport }（null=继承全局默认）——
  vncPlayback      Json?
  // —— r28：回收站保留期组级基线（天，null=继承全局默认；0=永久保留）——
  recycleRetentionDays Int?
  // —— r28：文件传输限速组级基线（KB/s，null=继承全局；0=不限）——
  fileTransferKBps Int?
  // —— r29：17 项硬件权限组级基线（稀疏 JSON；null=继承父组/全局）——
  hardwarePolicy  Json?
  // —— r33：存储配额组级基线（null=继承全局；0=不限；用户级可覆盖）——
  storageQuotaMb     Int? // 总配额（MB）
  storagePolicy      Json? // { recording?: bool, screenshot?: bool, upload?: bool, recordingMb?: int, screenshotMb?: int, fileMb?: int }
  // —— r33：沙箱最大时长组级基线（null=继承全局；0=不限；用户级可覆盖）——
  maxTtlMinutes      Int?
  allowUnlimitedTtl  Boolean?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  @@index([parentId])
  @@index([deletedAt])
}

model GroupUser {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupAdmin {
  id             String   @id @default(cuid())
  groupId        String
  userId         String
  canModifyQuota Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([groupId, userId])
}

model GroupProxy {
  id           String   @id @default(cuid())
  groupId      String
  proxyNodeId  String
  createdAt    DateTime @default(now())

  @@unique([groupId, proxyNodeId])
}

// ============================================================
// 三、审计日志（只插入，禁止修改删除）
// ============================================================

model AuditLog {
  id             String   @id @default(cuid())
  traceId        String?
  operatorUserId String?
  operatorName   String?
  operationType  String
  resourceType   String
  resourceId     String?
  resourceName   String?
  ownerUserId    String? // 资源当前所有者
  createdByUserId String? // 资源原始创建人
  clientIp       String?
  userAgent      String?
  severity       String   @default("INFO") // INFO | WARN | CRITICAL | DANGER
  beforeJson     String?
  afterJson      String?
  extraJson      String?
  createdAt      DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([operatorUserId, createdAt])
  @@index([createdAt])
  @@index([operationType])
}

model AuditLogArchive {
  id             String   @id @default(cuid())
  originId       String
  traceId        String?
  operatorUserId String?
  operatorName   String?
  operationType  String
  resourceType   String
  resourceId     String?
  resourceName   String?
  ownerUserId    String?
  createdByUserId String?
  clientIp       String?
  severity       String?
  beforeJson     String?
  afterJson      String?
  extraJson      String?
  archivedAt     DateTime @default(now())
  createdAt      DateTime

  @@index([resourceType, resourceId])
}

// ============================================================
// 四、API-Token
// ============================================================

model ApiToken {
  id             String    @id @default(cuid())
  userId         String
  name           String
  tokenHash      String    @unique
  tokenPrefix    String // 前8位用于辨识
  permissionsMask Int      @default(0)
  // 功能范围（scope 白名单）：null/[] = 不限（全部授权范围）；
  // 非空数组 = 仅允许调用命中数组内 scope 的功能面（browser/proxy/user/token/recycle/session/crx/resources）
  scopes         Json?
  ipWhitelist    Json?
  qpsLimit       Float     @default(0) // 0 = 全局默认
  rateLimitPerMin Int? // r23：每Key每分钟调用上限覆盖（null=继承策略链：用户/组/全局 mcp.perKeyPerMinute）
  expireAt       DateTime? // null = 永久
  enabled        Boolean   @default(true)
  lastCallAt     DateTime?
  callCount      Int       @default(0)
  failCount      Int       @default(0)
  createdByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([userId, deletedAt])
  @@index([expireAt])
}

model ApiTokenCallLog {
  id           String   @id @default(cuid())
  tokenId      String?
  tokenUserId  String?
  path         String
  method       String
  status       Int
  durationMs   Int
  wasExpired   Boolean  @default(false) // 调用时Token是否已过期
  ip           String?
  traceId      String?
  createdAt    DateTime @default(now())

  @@index([tokenId, createdAt])
  @@index([tokenUserId, createdAt])
  @@index([createdAt])
}

// ============================================================
// 五、系统配置 / 定时任务 / 幂等
// ============================================================

model SystemConfig {
  key          String   @id
  valueJson    String
  category     String   @default("GENERAL") // SECURITY | SESSION | STORAGE | ALERT | NETWORK | UI | GENERAL | MCP
  valueType    String   @default("string") // string | number | boolean | json
  description  String?
  version      Int      @default(1)
  updatedByUserId String?
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model ConfigVersion {
  id             String   @id @default(cuid())
  configKey      String
  version        Int
  beforeJson     String?
  afterJson      String?
  operatorUserId String?
  createdAt      DateTime @default(now())

  @@index([configKey, version])
}

model ScheduleTask {
  code             String   @id
  name             String
  cronExpr         String
  enabled          Boolean  @default(true)
  timeoutSec       Int      @default(300)
  dependsOn        String?  // 依赖任务code
  consecutiveFails Int      @default(0)
  lastExecuteAt    DateTime?
  lastResult       String?
  avgDurationMs    Int      @default(0)
  // —— r23：自定时任务（管理员可创建/编辑/删除的自定义调度，基于内置任务类型注册表）——
  isCustom         Boolean  @default(false) // true=自定义任务（code 形如 custom:<cuid>）
  taskType         String?  // 执行的任务类型（TASKS 注册表键；内置任务=null 即用 code 本身）
  paramsJson       String?  // 任务参数（预留，目前注册表任务无参数）
  description      String?  // 自定义任务备注说明
  createdByUserId  String?  // 创建人（自定义任务审计追溯）
  nextRunAt        DateTime? // r23：按 cron 表达式计算的下次到期时间（到期调度器/接口据此触发）
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ScheduleTaskLog {
  id          String   @id @default(cuid())
  taskCode    String
  triggerType String   @default("CRON") // CRON | MANUAL
  status      String   @default("RUNNING") // RUNNING | SUCCESS | FAILED | TIMEOUT
  startAt     DateTime @default(now())
  endAt       DateTime?
  durationMs  Int?
  errorStack  String?
  summary     String?
  itemsProcessed Int  @default(0)
  outputJson  String?  // r24-a：参数化执行体完整输出（脚本 stdout / 响应体，上限 64KB）

  @@index([taskCode, startAt])
  @@index([status])
  @@index([startAt])
}

// —— r23：IP 自动封禁（登录/API-Key 连续失败计数 → 定时封禁；与手工 RiskListRule 黑名单互补）——
model IpBanRecord {
  id            String    @id @default(cuid())
  ip            String
  source        String    @default("LOGIN") // LOGIN | API_KEY | MANUAL
  failCount     Int       @default(0) // 窗口内累计失败次数
  firstFailAt   DateTime?
  lastFailAt    DateTime?
  bannedUntil   DateTime? // null=当前未封禁（仅计数）；非空=封禁生效中
  reason        String?   // 封禁原因
  note          String?   // 管理员备注（手动封禁/解封说明）
  createdByUserId String? // 手动封禁操作人
  unbannedByUserId String? // 手动解封操作人
  unbannedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([ip])
  @@index([bannedUntil])
  @@index([lastFailAt])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  userId      String?
  action      String
  resultJson  String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

// ============================================================
// 六、文件存储与备份
// ============================================================

model FileMeta {
  id            String    @id @default(cuid())
  fileName      String
  storageKey    String    @unique
  size          Int       @default(0)
  mime          String?
  checksum      String?
  category      String    @default("GENERAL") // GENERAL | PROFILE | BACKUP | SNAPSHOT | LOG | REPORT | RECORDING | SCREENSHOT | AVATAR
  // r32：收藏夹（用户云盘多标签页/收藏夹）+ 分布式节点归属（节点筛选；空 = 主节点本地存储）
  isFavorite    Boolean   @default(false)
  favoritedBy   String?
  favoritedAt   DateTime?
  storageNodeId String? // GENERAL | PROFILE | BACKUP | SNAPSHOT | LOG | REPORT
  userId        String?
  workspaceId   String?
  shareTo       Json?
  expireAt      DateTime?
  virusScanned  Boolean   @default(false)
  createdByUserId String?
  deletedAt     DateTime?
  purgedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, deletedAt])
  @@index([category])
  @@index([expireAt])
  @@index([storageNodeId])
  @@index([isFavorite, userId])
}

model BackupRecord {
  id            String   @id @default(cuid())
  fileMetaId    String
  type          String   @default("FULL") // FULL | PARTIAL
  tableList     Json?
  encrypted     Boolean  @default(false)
  sizeBytes     Int      @default(0)
  checksum      String?
  status        String   @default("SUCCESS") // SUCCESS | FAILED | RESTORING
  createdByUserId String?
  createdAt     DateTime @default(now())
  // r36：多节点副本状态（JSON：[{nodeUuid, state: PENDING|SENT|OK|FAIL, error?, at?}]）
  replicasJson  String?

  @@index([createdAt])
}

// ============================================================
// r36：Worker 指令队列（主控 → Worker 下行通道；心跳携出/结果回传）
// 用途：备份多节点推送（backup.replica.* 分块）、后续调度/控制指令统一通道
// ============================================================
model WorkNodeCommand {
  id          String    @id @default(cuid())
  nodeUuid    String
  cmd         String // backup.replica.begin | backup.replica.append | backup.replica.finish | ping ...
  payloadJson String
  createdAt   DateTime  @default(now())
  sentAt      DateTime? // 心跳携出时间（首次/重试）
  doneAt      DateTime? // Worker 结果回传时间
  resultJson  String? // { ok, error?, data? }
  retries    Int       @default(0)

  @@index([nodeUuid, sentAt])
  @@index([createdAt])
}

// ============================================================
// 七、告警 / 通知 / Webhook
// ============================================================

model Alert {
  id             String   @id @default(cuid())
  title          String
  level          String   @default("WARN") // INFO | WARN | CRITICAL
  content        String
  resourceType   String?
  resourceId     String?
  ownerUserId    String?
  traceId        String?
  dedupeKey      String?  // 抑制/聚合键
  triggerAt      DateTime @default(now())
  handleStatus   String   @default("PENDING") // PENDING | HANDLED | AUTO_RESOLVED
  handledByUserId String?
  handledAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([level, handleStatus])
  @@index([createdAt])
  @@index([dedupeKey])
}

model AlertRule {
  id             String   @id @default(cuid())
  name           String
  conditionsJson String // [{field,op,value}] + logic: AND/OR
  level          String   @default("WARN")
  silenceWindowMin Int    @default(30)
  webhookEnabled Boolean  @default(true)
  enabled        Boolean  @default(true)
